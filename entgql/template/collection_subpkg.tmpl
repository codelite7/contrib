{{ define "gql_collection_subpkg" }}

{{- /*gotype: entgo.io/contrib/entgql.collectionEntityData*/ -}}

{{ $.Config.Header }}

package {{ $.Node.Package }}

{{ $node := $.Node -}}
{{ $query := $node.QueryName -}}
{{ $gqlNodes := filterNodes $.Nodes (skipMode "type") -}}
{{ $idType := gqlIDType $gqlNodes $.IDType -}}

import (
	"context"

	"entgo.io/contrib/entgql"
	"github.com/99designs/gqlgen/graphql"
)

// Cursor is the per-entity opaque pagination cursor. It is an alias for
// the same generic type the gen package uses for *Cursor — the two are
// freely interchangeable through the alias and the subpkg can refer to
// the type without importing the gen package (which would create a
// cycle, since gen imports the subpkg for the *Query type alias).
type Cursor = entgql.Cursor[{{ $idType }}]

// Field-name string constants used by newPaginateArgs to look up the
// decoded GraphQL pagination arguments. Mirrors the constants in
// gen-package gql_collection.go (subpkg cannot import gen — cycle).
const (
	afterField   = "after"
	firstField   = "first"
	beforeField  = "before"
	lastField    = "last"
	orderByField = "orderBy"
	whereField   = "where"
)

// CollectFields tells the query-builder to eagerly load connected nodes
// by resolver context. The receiver is the LOCAL subpkg {{ $query }}
// type — reachable from the gen package via the PR 6 alias
// (gen).{{ $query }} = ({{ $node.Package }}).{{ $query }}, so existing
// callers using ent.{{ $query }}.CollectFields continue to work.
//
// Edge handling is deliberately deferred. Today this method walks
// scalar field selections so a query that requests only own-entity
// fields gets a precise SELECT clause; for edge sub-selections it
// acknowledges the field (so unknownSeen stays false) but leaves the
// eager-load configuration untouched.
//
// Full cross-entity edge wiring requires either:
//   (a) calling parent.StoreEager(name, loader) from this subpkg with a
//       loader that uses per-edge load helpers — but those helpers
//       (loadXChildren, loadXCategory, …) live in the gen-package
//       facade today, and the subpkg cannot import gen without a cycle
//       (gen has type aliases pointing back to subpkg); or
//   (b) routing through collectiondispatch.Get(otherPkg).AssignEagerLoad
//       — which is interface-shaped today but stubbed at the
//       implementation site for the same reason: the implementation
//       lives in the OTHER subpkg's gql_collection_dispatch.go and
//       still needs typed access to gen-package load helpers.
//
// The unblocker is moving per-edge load helpers into the subpkg too.
// That's a separate architectural task; this template ships the
// scalar-field narrowing now so callers requesting only own-entity
// columns benefit from precise SELECTs and the Bug 9 `go build` check
// passes.
func (q *{{ $query }}) CollectFields(ctx context.Context, satisfies ...string) (*{{ $query }}, error) {
	fc := graphql.GetFieldContext(ctx)
	if fc == nil {
		return q, nil
	}
	if err := q.collectField(ctx, false, graphql.GetOperationContext(ctx), fc.Field, nil, satisfies...); err != nil {
		return nil, err
	}
	return q, nil
}

// collectField iterates the entity's scalar fields and narrows the
// SELECT list to the columns that the caller actually requested. Edge
// sub-selections cause the field to be acknowledged (so unknownSeen
// stays false) but do not configure any cross-entity sub-query — that
// wiring lives in follow-up tasks.
func (q *{{ $query }}) collectField(ctx context.Context, oneNode bool, opCtx *graphql.OperationContext, collected graphql.CollectedField, path []string, satisfies ...string) error {
	_ = oneNode
	_ = satisfies
	path = append([]string(nil), path...)
	_ = path
	{{- $fields := filterFields $node.Fields (skipMode "type") }}
	{{- $collects := fieldCollections (filterEdges $node.Edges (skipMode "type")) }}
	{{- if or $collects $fields }}
		{{- if $fields }}
		var (
			unknownSeen    bool
			fieldSeen      = make(map[string]struct{}, len(Columns))
			selectedFields =
			{{- if $node.HasOneFieldID -}}
				[]string{ {{ $node.ID.Constant }} }
			{{- else -}}
				make([]string, 0, len(Columns))
			{{- end }}
		)
		{{- end }}
		for _, field := range graphql.CollectFields(opCtx, collected.Selections, satisfies) {
			switch field.Name {
				{{- range $i, $fc := $collects }}
					{{- $e := $fc.Edge }}
					case {{ range $i, $value := $fc.Mapping }}{{ if $i }}, {{ end }}"{{ $value }}"{{ end }}:
						// Edge {{ $e.Name }}: eager-load wiring is blocked on the
						// subpkg → gen-package import cycle. The per-edge load
						// helpers (loadX{{ $e.StructField }}) live in the gen
						// facade and can't be reached from this subpkg without a
						// cycle. Acknowledge the field so the default branch does
						// not flip unknownSeen (which would suppress the SELECT
						// narrowing for the scalar fields below). When per-edge
						// load helpers move into the subpkg (separate follow-up
						// task), this branch fills in via
						// collectiondispatch.Get(otherPkg).AssignEagerLoad.
						_ = field
						{{- with $e.Field }}
							if _, ok := fieldSeen[{{ .Constant }}]; !ok {
								selectedFields = append(selectedFields, {{ .Constant }})
								fieldSeen[{{ .Constant }}] = struct{}{}
							}
						{{- end }}
				{{- end }}
				{{- range $f := $fields }}
					{{- with fieldMapping $f }}
						case {{ range $i, $m := . }}{{ if $i }}, {{ end }}"{{ $m }}"{{ end }}:
							if _, ok := fieldSeen[{{ $f.Constant }}]; !ok {
								selectedFields = append(selectedFields, {{ $f.Constant }})
								fieldSeen[{{ $f.Constant }}] = struct{}{}
							}
					{{- end }}
				{{- end }}
				{{- if $fields }}
					{{- if $node.HasOneFieldID -}}
						{{- with fieldMapping $node.ID }}
						case {{ range $i, $m := . }}{{ if $i }}, {{ end }}"{{ $m }}"{{ end }}:
						{{- end }}
					{{- end -}}
				case "__typename":
				default:
					unknownSeen = true
				{{- end }}
			}
		}
		{{- if $fields }}
			if !unknownSeen {
				q.Select(selectedFields...)
			}
		{{- end }}
	{{- end }}
	return nil
}

{{ $names := nodePaginationNames $node -}}
{{- $name := $names.Node -}}
{{- $multiOrder := $node.Annotations.EntGQL.MultiOrder -}}

// paginateArgs are this entity's per-call pagination inputs. Moved from
// the gen-package <entity>PaginateArgs into the sub-package as the
// unqualified local name. Other entities access these via
// collectiondispatch (PaginateArgs* methods on EntityCollector).
//
// opts is typed []any rather than []<Entity>PaginateOption because the
// pager type (and its functional-option type) currently live in the gen
// package; subpkg cannot import gen without a cycle. The receiving end
// (gen package's new<Entity>Pager via the dispatch boundary) is
// responsible for asserting each element back to its concrete type.
type paginateArgs struct {
	first, last   *int
	after, before *Cursor
	opts          []any
}

// newPaginateArgs decodes the field-args map produced by fieldArgs into
// a paginateArgs value. The order and where-input branches assemble
// opts as untyped any values so this file does not need to import the
// gen package; consumers in gen package handle the type assertions.
func newPaginateArgs(rv map[string]any) *paginateArgs {
	args := &paginateArgs{}
	if rv == nil {
		return args
	}
	if v := rv[firstField]; v != nil {
		args.first = v.(*int)
	}
	if v := rv[lastField]; v != nil {
		args.last = v.(*int)
	}
	if v := rv[afterField]; v != nil {
		args.after = v.(*Cursor)
	}
	if v := rv[beforeField]; v != nil {
		args.before = v.(*Cursor)
	}
	{{- with orderFields $node }}
		// orderBy is forwarded untyped. The dispatch consumer
		// (gen-package new{{ $name }}Pager) asserts it back to the
		// typed order value(s) and applies the appropriate
		// With{{ $name }}Order option. Decoding here would require
		// importing gen-package types and recreates the cycle.
		if v, ok := rv[orderByField]; ok && v != nil {
			args.opts = append(args.opts, v)
		}
	{{- end }}
	{{- if $.HasWhereInputTemplate }}
		{{- $withWhere := true }}{{ with $node.Annotations.EntGQL }}{{ if isSkipMode .Skip "where_input" }}{{ $withWhere = false }}{{ end }}{{ end }}
		{{- if $withWhere }}
			// where input is also passed through untyped; gen-package
			// consumer asserts to *{{ $names.WhereInput }} and applies the
			// With{{ $name }}Filter option.
			if v, ok := rv[whereField]; ok && v != nil {
				args.opts = append(args.opts, v)
			}
		{{- end }}
	{{- end }}
	_ = {{ printf "%q" $name }}
	{{- if $multiOrder }}{{ end }}
	return args
}

{{ end }}
