{{ define "gql_pagination_subpkg" }}

{{- /*gotype: entgo.io/contrib/entgql.paginationEntityData*/ -}}

{{ $node := $.Node }}
{{ $.Config.Header }}

package {{ $node.Package }}

{{ $gqlNodes := filterNodes $.Nodes (skipMode "type") }}
{{ $idType := gqlIDType $gqlNodes $.IDType }}
{{ $orderFields := orderFields $node }}

{{ $names := nodePaginationNames $node -}}
{{ $name := $names.Node -}}

import (
	"context"

	"entgo.io/contrib/entgql"
	"entgo.io/contrib/entgql/gqlpage"
	"entgo.io/ent/dialect/sql"
	"github.com/99designs/gqlgen/graphql"
)

// Cursor and PageInfo are local aliases to entgql.Cursor/PageInfo for this package.
// They alias the same types as root gen's shared pagination aliases and are interchangeable.
type (
	Cursor = entgql.Cursor[{{ $idType }}]
	PageInfo = entgql.PageInfo[{{ $idType }}]
	OrderDirection = entgql.OrderDirection
	NullsDirection = entgql.NullsDirection
)

{{- if not (eq $name $node.Name) }}
// {{ $name }} is the type alias for {{ $node.Name }}.
type {{ $name }} = {{ $node.Name }}
{{- end}}

{{ $r := $node.Receiver }}
{{ $query := $node.QueryName }}
{{- $multiOrder := false }}
{{- with $node.Annotations.EntGQL }}{{- if .MultiOrder }}{{- $multiOrder = true }}{{- end }}{{- end }}
{{ $marshalID := and $idType.Mixed (gqlMarshaler $node.ID) }}

// {{ $names.Edge }}, {{ $names.Connection }}, {{ $names.Order }}, {{ $names.OrderField }}
// and {{ $name }}PaginateOption are generic gqlpage instantiations for {{ $name }}.
// The per-entity glue gqlpage needs to drive them lives in {{ $name }}Ops below.
type (
	{{ $names.Edge }}            = gqlpage.Edge[{{ $name }}, {{ $idType }}]
	{{ $names.Connection }}      = gqlpage.Connection[{{ $name }}, {{ $idType }}]
	{{ $names.Order }}           = gqlpage.Order[{{ $name }}, {{ $idType }}]
	{{ $names.OrderField }}      = gqlpage.OrderField[{{ $name }}, {{ $idType }}]
	{{ $name }}PaginateOption    = gqlpage.Option[{{ $query }}, {{ $name }}, {{ $idType }}]
)

{{ $defaultOrder := print "Default" $name "Order" }}

{{- if $orderFields }}
	var (
		{{- range $f := $orderFields }}
			{{- $var := $f.VarName }}
			{{- if $f.IsFieldTerm }}
				// {{ $var }} orders {{ $f.Type.Name }} by {{ $f.Field.Name }}.
			{{- else }}
				// {{ $var }} orders by {{ $f.GQL }}.
			{{- end }}
			{{- if $f.IsFieldTerm }}
				{{- if $f.HasExpression }}
		{{ $var }} = gqlpage.Column[{{ $name }}, {{ $idType }}]("{{ $f.GQL }}", {{ $f.Field.Constant }}, "{{ $f.Field.StructField }}", F.{{ $f.Field.StructField }}.Order, gqlpage.Expr(`{{ $f.Expression }}`))
				{{- else }}
		{{ $var }} = gqlpage.Column[{{ $name }}, {{ $idType }}]("{{ $f.GQL }}", {{ $f.Field.Constant }}, "{{ $f.Field.StructField }}", F.{{ $f.Field.StructField }}.Order)
				{{- end }}
			{{- else if $f.IsNonUniqueEdgeFieldTerm }}
		{{ $var }} = gqlpage.Computed[{{ $name }}, {{ $idType }}]("{{ $f.GQL }}", {{ $f.VarField }}, {{ $f.VarField }}, func(opts ...sql.OrderTermOption) func(*sql.Selector) {
			// For non-unique edges, create a custom ordering function.
			// Use raw string literals to avoid importing cross-entity subpackages
			// (which would create mutual import cycles).
			return func(s *sql.Selector) {
				joinT := sql.Table({{ quote $f.Type.Table }})
				termOpts := sql.NewOrderTermOptions(opts...)
				direction := "ASC"
				nullsDir := "NULLS LAST"
				if termOpts.Desc {
					direction = "DESC"
				}
				if termOpts.NullsFirst {
					nullsDir = "NULLS FIRST"
				}
				var aggregateFunc string
				if termOpts.Desc {
					aggregateFunc = "MAX"
				} else {
					aggregateFunc = "MIN"
				}
				subquery := sql.Select({{ $f.Edge.ColumnConstant }}).
					AppendSelectExprAs(
						sql.ExprFunc(func(b *sql.Builder) {
							b.WriteString(aggregateFunc + "(").
								Ident({{ quote $f.Field.StorageKey }}).
								WriteString(")")
						}),
						{{ $f.VarField }},
					).
					From(joinT).
					GroupBy({{ $f.Edge.ColumnConstant }})
				s.LeftJoin(subquery.As("t_" + {{ $f.VarField }})).On(
					s.C(FieldID),
					sql.Table("t_" + {{ $f.VarField }}).C({{ $f.Edge.ColumnConstant }}),
				)
				s.OrderExpr(sql.ExprFunc(func(b *sql.Builder) {
					b.Ident("t_" + {{ $f.VarField }}).WriteString(".").Ident({{ $f.VarField }}).
						Pad().WriteString(direction).
						Pad().WriteString(nullsDir)
				}))
			}
		})
			{{- else if $f.IsEdgeFieldTerm }}
		{{ $var }} = gqlpage.Computed[{{ $name }}, {{ $idType }}]("{{ $f.GQL }}", {{ $f.VarField }}, {{ $f.VarField }}, func(opts ...sql.OrderTermOption) func(*sql.Selector) {
			// Use raw string literal for field name to avoid cross-entity import cycles.
			return E.{{ $f.Edge.StructField }}.OrderBy(
				sql.OrderByField(
					{{ quote $f.Field.StorageKey }},
					append(opts, sql.OrderSelectAs({{ $f.VarField }}))...,
				),
			)
		})
			{{- else if $f.IsEdgeCountTerm }}
		{{ $var }} = gqlpage.Computed[{{ $name }}, {{ $idType }}]("{{ $f.GQL }}", {{ $f.VarField }}, {{ $f.VarField }}, func(opts ...sql.OrderTermOption) func(*sql.Selector) {
			return E.{{ $f.Edge.StructField }}.OrderByCount(
				append(opts, sql.OrderSelectAs({{ $f.VarField }}))...,
			)
		})
			{{- end }}
		{{- end }}
	)

	func init() {
		gqlpage.Register[{{ $name }}, {{ $idType }}](
			{{- range $f := $orderFields }}
			{{ $f.VarName }},
			{{- end }}
		)
	}
{{- end }}

// {{ $defaultOrder }} is the default ordering of {{ $node.Name }}.
var {{ $defaultOrder }} = &{{ $names.Order }}{
	Direction: entgql.OrderDirectionAsc,
	Field:     gqlpage.Column[{{ $name }}, {{ $idType }}]("ID", {{ $node.ID.Constant }}, "ID", F.{{ $node.ID.StructField }}.Order),
}

// collectFieldFn{{ $query }} is set by the gqlcollections sibling subpackage via Register{{ $query }}CollectFieldFn.
// It breaks the subpkg→gqlcollections import cycle: gen/gqlcollections/<entity>.go defines the function and
// registers it here at package-init time, avoiding a direct import of gqlcollections from this entity subpackage.
// The last parameter is variadic to match the codegen-emitted collectField signature.
var collectFieldFn{{ $query }} func(*{{ $query }}, context.Context, bool, *graphql.OperationContext, graphql.CollectedField, []string, ...string) error

// Register{{ $query }}CollectFieldFn registers the per-entity collectField helper.
// Called from gqlcollections's gen/gqlcollections/<entity>.go init() (lever B-3d split).
func Register{{ $query }}CollectFieldFn(fn func(*{{ $query }}, context.Context, bool, *graphql.OperationContext, graphql.CollectedField, []string, ...string) error) {
	collectFieldFn{{ $query }} = fn
}

{{- $byEdges := list }}
{{- range $orderFields }}{{ if not .IsFieldTerm }}{{ $byEdges = append $byEdges . }}{{ end }}{{ end }}

{{- $maxPageSize := 0 }}
{{- $extAnn := index $.Annotations "EntGQLExtension" }}
{{- if $extAnn }}{{- $maxPageSize = $extAnn.MaxPageSize }}{{- end }}

// {{ $name }}Ops is the per-entity glue gqlpage.Paginate needs from *{{ $query }}
// that isn't expressible as a shared method set. Exported (not entityOps) so the
// gqledges sibling subpackage (lever B-3c) can build edge-connection resolvers
// against it without going through the root gen package.
var {{ $name }}Ops = &gqlpage.Ops[{{ $query }}, {{ $name }}, {{ $idType }}]{
	Where:       func(q *{{ $query }}, p func(*sql.Selector)) *{{ $query }} { return q.Where(p) },
	Order:       func(q *{{ $query }}, o func(*sql.Selector)) *{{ $query }} { return q.Order(o) },
	Limit:       func(q *{{ $query }}, n int) *{{ $query }} { return q.Limit(n) },
	Clone:       func(q *{{ $query }}) *{{ $query }} { return q.Clone() },
	All:         func(q *{{ $query }}, ctx context.Context) ([]*{{ $name }}, error) { return q.All(ctx) },
	Count:       func(q *{{ $query }}, ctx context.Context) (int, error) { return q.Count(ctx) },
	Fields:      func(q *{{ $query }}) []string { return q.Ctx.Fields },
	AppendField: func(q *{{ $query }}, f string) { q.Ctx.AppendFieldOnce(f) },
	ClearFields: func(q *{{ $query }}) { q.Ctx.Fields = nil },
	ID:          func({{ $r }} *{{ $name }}) {{ $idType }} { return {{ $r }}.{{ if $marshalID }}marshalID(){{ else }}ID{{ end }} },
	Default:     {{ $defaultOrder }},
	MultiOrder:  {{ $multiOrder }},
	MaxPageSize: {{ $maxPageSize }},
	{{- with $byEdges }}
	EdgeTermColumns: []string{ {{ range $i, $f := . }}{{ if $i }}, {{ end }}{{ $f.VarName }}.Column(){{ end }} },
	{{- end }}
	Collect: func() func(*{{ $query }}, context.Context, bool, *graphql.OperationContext, graphql.CollectedField, []string, ...string) error {
		return collectFieldFn{{ $query }}
	},
}

{{ $opt := print $name "PaginateOption" }}

{{ $optOrder := print "With" $names.Order -}}
// {{ $optOrder }} configures pagination ordering.
func {{ $optOrder }}(order {{ if $multiOrder }}[]{{ end }}*{{ $names.Order }}) {{ $opt }} {
	{{- if $multiOrder }}
	return gqlpage.WithOrder[{{ $query }}, {{ $name }}, {{ $idType }}](order)
	{{- else }}
	return gqlpage.WithOrder[{{ $query }}, {{ $name }}, {{ $idType }}]([]*{{ $names.Order }}{order})
	{{- end }}
}

{{ $optFilter := print "With" $name "Filter" -}}
// {{ $optFilter }} configures pagination filter.
func {{ $optFilter }}(filter func(*{{ $query }}) (*{{ $query }}, error)) {{ $opt }} {
	return gqlpage.WithFilter[{{ $query }}, {{ $name }}, {{ $idType }}](filter)
}

{{ $NewPager := print "New" $name "Pager" -}}
// {{ $NewPager }} is the exported pager constructor for {{ $name }}.
// Used by root gen's collection files (lever B-2 split) and the gqledges/gqlcollections
// sibling subpackages, which cannot reference an unexported constructor.
func {{ $NewPager }}(opts []{{ $opt }}, reverse bool) (*gqlpage.Pager[{{ $query }}, {{ $name }}, {{ $idType }}], error) {
	return gqlpage.NewPager({{ $name }}Ops, opts, reverse)
}

// {{ $query }}Paginate executes the query and returns a relay based cursor connection to {{ $name }}.
// Free function (rather than method) because *{{ $query }} is a type alias after PR 6's sub-package split,
// and Go forbids defining methods on alias types from foreign packages.
func {{ $query }}Paginate(
	{{ $r }} *{{ $query }},
	ctx context.Context, after *Cursor, first *int,
	before *Cursor, last *int, opts ...{{ $opt }},
) (*{{ $names.Connection }}, error) {
	return gqlpage.Paginate({{ $r }}, ctx, after, first, before, last, {{ $name }}Ops, opts...)
}

// {{ $name }}ToEdge converts {{ $name }} into {{ $names.Edge }}.
func {{ $name }}ToEdge({{ $r }} *{{ $name }}, order *{{ $names.Order }}) *{{ $names.Edge }} {
	return gqlpage.ToEdge({{ $r }}, order, {{ $defaultOrder }})
}

{{ end }}
