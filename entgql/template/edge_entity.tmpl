{{ define "gql_edge_entity" }}

{{- /*gotype: entgo.io/contrib/entgql.edgeEntityData*/ -}}

{{ $pkg := base $.Config.Package }}
{{ $.Config.Header }}

package {{ $pkg }}

{{ $node := $.Node }}
{{ $nodePkg := $node.Package }}

import (
	"context"

	"{{ $.Config.Package }}/{{ $nodePkg }}"
	"{{ $.Config.Package }}/gqledges"
)

{{- /* Register the per-entity client accessor so gqledges body code can resolve the client without importing root. */}}
func init() {
	gqledges.Register{{ $node.Name }}ClientFromCtx(func(ctx context.Context) *{{ $nodePkg }}.{{ $node.ClientName }} {
		c := FromContext(ctx)
		if c == nil {
			return nil
		}
		return c.{{ $node.Name }}
	})
}

{{- /* Var forwarders so consumer code referencing gen.Resolve<Entity><Edge> keeps resolving. */}}
var (
{{- range $e := nonUnionEdges $node }}
	Resolve{{ $node.Name }}{{ $e.StructField }} = gqledges.Resolve{{ $node.Name }}{{ $e.StructField }}
{{- end }}
{{- range $u := nodeUnions $node }}
	Resolve{{ $node.Name }}{{ goName $u.Field }} = gqledges.Resolve{{ $node.Name }}{{ goName $u.Field }}
{{- end }}
)

{{ end }}
