{{ define "gql_mutation_input_entity" }}

{{- /*gotype: entgo.io/contrib/entgql.mutationInputEntityData*/ -}}

{{ $pkg := base $.Config.Package }}
{{ $.Config.Header }}

package {{ $pkg }}

{{ $inputs := $.Inputs }}

import (
    "{{ $.Config.Package }}/mutationinputs"
)

{{- /* mutation_input bodies live in <Config.Package>/mutationinputs (lever B-3b split).
   Root retains thin type aliases + var forwarders so gen.<Input> + gen.Set<Builder>Input keep resolving. */}}
{{- range $n := $inputs }}
    {{- $input := $n.Input }}
    // {{ $input }} is a type alias re-exported from the mutationinputs sibling subpackage.
    type {{ $input }} = mutationinputs.{{ $input }}

    {{- range $b := $n.Builders }}
    // Set{{ $b }}Input is re-exported from the mutationinputs sibling subpackage.
    var Set{{ $b }}Input = mutationinputs.Set{{ $b }}Input
    {{- end }}
{{- end }}
{{ end }}
