{{ define "gql_pagination_shared" }}

{{- /*gotype: entgo.io/contrib/entgql.paginationSharedData*/ -}}

{{ $pkg := base $.Config.Package }}
{{ $.Config.Header }}

package {{ $pkg }}

{{ $gqlNodes := filterNodes $.Nodes (skipMode "type") }}
{{ $idType := gqlIDType $gqlNodes $.IDType }}

import (
	"context"

	"entgo.io/contrib/entgql"
	"entgo.io/contrib/entgql/gqlpage"
	"github.com/99designs/gqlgen/graphql"
	"github.com/vektah/gqlparser/v2/gqlerror"
	{{- if $idType.PkgPath }}
	"{{ $idType.PkgPath }}"
	{{- end }}
)

// Common entgql types.
type (
	Cursor = entgql.Cursor[{{ $idType }}]
	PageInfo = entgql.PageInfo[{{ $idType }}]
	OrderDirection = entgql.OrderDirection
	NullsDirection = entgql.NullsDirection
)

// validateFirstLast, collectedField and hasCollectedField forward to gqlpage.
// Kept at root (rather than deleted outright) because entsearch-generated
// files in this same package (search_pagination.go) call them unqualified.
func validateFirstLast(first, last *int) *gqlerror.Error {
	return gqlpage.ValidateFirstLast(first, last)
}

func collectedField(ctx context.Context, path ...string) *graphql.CollectedField {
	return gqlpage.CollectedField(ctx, path...)
}

func hasCollectedField(ctx context.Context, path ...string) bool {
	return gqlpage.HasCollectedField(ctx, path...)
}

const (
	{{- range $field := list "edges" "node" }}
		{{ $field }}Field = "{{ $field }}"
	{{- end }}
)

{{ end }}
