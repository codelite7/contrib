{{ define "gql_edge_subpkg" }}

{{- /*gotype: entgo.io/contrib/entgql.edgeEntityData*/ -}}

{{ $.Config.Header }}

package gqledges

{{ $node := $.Node }}
{{ $r := $node.Receiver }}
{{ $nodePkg := $node.Package }}

{{- $relayEdges := list }}
{{- $edgePkgs := list }}
{{- range filterEdges $node.Edges (skipMode "type") }}
	{{- if isRelayConn . }}{{ $relayEdges = append $relayEdges . }}{{ end }}
	{{- $edgePkgs = append $edgePkgs .Type.Package }}
{{- end }}

import (
	"context"

	"github.com/99designs/gqlgen/graphql"
	"{{ $.Config.Package }}/{{ $nodePkg }}"
	"{{ $.Config.Package }}/edges"
	{{- /* Import edge-type subpackages for return types (e.g. *user.User) and for relay-connection edges so we can call New<Edge>Pager. */}}
	{{- range $p := $edgePkgs }}
		{{- if ne $p $nodePkg }}
		"{{ $.Config.Package }}/{{ $p }}"
		{{- end }}
	{{- end }}
	{{- if $.HasWhereInputTemplate }}
		{{- range $e := $relayEdges }}
			{{- if hasWhereInput $e }}
		"{{ $.Config.Package }}/whereinputs"
				{{- /* break after first */}}
			{{- end }}
		{{- end }}
	{{- end }}
)

{{- /* Per-entity client accessor: root gen wires this via init in the entity shim. */}}
// {{ $node.Name }}ClientFromCtx returns the {{ $node.Name }} client bound to ctx.
// Set by root gen's gql_edge_{{ snake $node.Name }}.go init() to break the root<->sibling cycle.
var {{ camel $node.Name }}ClientFromCtx func(context.Context) *{{ $nodePkg }}.{{ $node.ClientName }}

// Register{{ $node.Name }}ClientFromCtx is called by root gen's init() to register the client accessor.
func Register{{ $node.Name }}ClientFromCtx(fn func(context.Context) *{{ $nodePkg }}.{{ $node.ClientName }}) {
	{{ camel $node.Name }}ClientFromCtx = fn
}

{{ range $i, $e := filterEdges $node.Edges (skipMode "type") }}
	{{- $epkg := $e.Type.Package }}
	{{ if isRelayConn $e }}
		{{- /* Inlined gql_edge/helper/paginate logic */ -}}
		{{ $names := nodePaginationNames $e.Type }}
		{{ $order := $names.Order }}
		{{ $multiOrder := $e.Type.Annotations.EntGQL.MultiOrder }}
		{{ $whereInput := $names.WhereInput }}
		{{- $edge := $names.Edge }}
		{{ $conn := $names.Connection }}
		{{ $opt := print $names.Node "PaginateOption" }}
		{{ $newPager := print $epkg ".New" $names.Node "Pager" }}

		// Resolve{{ $node.Name }}{{ $e.StructField }} resolves the {{ $e.Name }} edge of a {{ $node.Name }}.
		func Resolve{{ $node.Name }}{{ $e.StructField }}({{ $r }} *{{ $nodePkg }}.{{ $node.Name }},
			ctx context.Context, after *{{ $epkg }}.Cursor, first *int, before *{{ $epkg }}.Cursor, last *int,
			{{- if orderFields $e.Type }}orderBy {{ if $multiOrder }}[]{{ end }}*{{ $epkg }}.{{ $order }},{{ end }}
			{{- if and $.HasWhereInputTemplate (hasWhereInput $e) }}where *whereinputs.{{ $whereInput }},{{ end }}
		) (*{{ $epkg }}.{{ $conn }}, error) {
			opts := []{{ $epkg }}.{{ $opt }}{
			{{- if orderFields $e.Type }}
				{{ $epkg }}.{{ print "With" $order }}(orderBy),
			{{- end }}
			{{- if and $.HasWhereInputTemplate (hasWhereInput $e) }}
				{{ $epkg }}.{{ print "With" $names.Node "Filter" }}(where.Filter),
			{{- end }}
			}
			{{- /* May be nil if the totalCount was not loaded. */}}
			alias := graphql.GetFieldContext(ctx).Field.Alias
			totalCount, hasTotalCount := {{ $r }}.Edges.TotalCount[{{ $i }}][alias]
			{{- /* Nodes were loaded, totalCount was loaded, or both. */}}
			if nodes, err := {{ $r }}.Named{{ $e.StructField }}(alias); err == nil || hasTotalCount {
				pager, err := {{ $newPager }}(opts, last != nil)
				if err != nil {
					return nil, err
				}
				{{- /* Ensure the "edges" field is marshaled as "[]" in case it is empty. */}}
				conn := &{{ $epkg }}.{{ $conn }}{Edges: []*{{ $epkg }}.{{ $edge }}{}, TotalCount: totalCount}
				conn.Build(nodes, pager.ToCursor, pager.Reverse(), after, first, before, last)
				return conn, nil
			}
			return {{ $epkg }}.{{ print $names.Node "QueryPaginate" }}(edges.Query{{ $node.Name }}{{ $e.StructField }}({{ camel $node.Name }}ClientFromCtx(ctx), {{ $r }}), ctx, after, first, before, last, opts...)
		}

	{{ else if not $e.Unique }}
		// Resolve{{ $node.Name }}{{ $e.StructField }} resolves the {{ $e.Name }} edge of a {{ $node.Name }}.
		func Resolve{{ $node.Name }}{{ $e.StructField }}({{ $r }} *{{ $nodePkg }}.{{ $node.Name }}, ctx context.Context) (result []*{{ $epkg }}.{{ $e.Type.Name }}, err error) {
			if fc := graphql.GetFieldContext(ctx); fc != nil && fc.Field.Alias != "" {
				result, err = {{ $r }}.Named{{ $e.StructField }}(graphql.GetFieldContext(ctx).Field.Alias)
			} else {
				{{- /* For regular edges (not Relay connections), we fallback to .Edges field in case the context is not GraphQL */}}
				result, err = {{ $r }}.Edges.{{ $e.StructField }}OrErr()
			}
			if IsNotLoaded(err) {
				result, err = edges.Query{{ $node.Name }}{{ $e.StructField }}({{ camel $node.Name }}ClientFromCtx(ctx), {{ $r }}).All(ctx)
			}
			return result, err
		}

	{{ else }}
		// Resolve{{ $node.Name }}{{ $e.StructField }} resolves the {{ $e.Name }} edge of a {{ $node.Name }}.
		func Resolve{{ $node.Name }}{{ $e.StructField }}({{ $r }} *{{ $nodePkg }}.{{ $node.Name }}, ctx context.Context) (*{{ $epkg }}.{{ $e.Type.Name }}, error) {
			result, err := {{ $r }}.Edges.{{ $e.StructField }}OrErr()
			if IsNotLoaded(err) {
				result, err = edges.Query{{ $node.Name }}{{ $e.StructField }}({{ camel $node.Name }}ClientFromCtx(ctx), {{ $r }}).Only(ctx)
			}
			return result, {{ if $e.Optional }}MaskNotFound(err){{ else }}err{{ end }}
		}

	{{ end }}
{{ end }}

{{ end }}
