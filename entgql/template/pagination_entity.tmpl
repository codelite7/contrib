{{ define "gql_pagination_entity" }}

{{- /*gotype: entgo.io/contrib/entgql.paginationEntityData*/ -}}

{{ $pkg := base $.Config.Package }}
{{ $.Config.Header }}

package {{ $pkg }}

{{ $node := $.Node }}
{{ $orderFields := orderFields $node }}

{{ $names := nodePaginationNames $node -}}
{{ $name := $names.Node -}}

import (
	"{{ $.Config.Package }}/{{ $node.Package }}"
)

// Type aliases — body lives in {{ $node.Package }}/gql_pagination.go (lever B-2 split).
type (
	{{ $names.Edge }}            = {{ $node.Package }}.{{ $names.Edge }}
	{{ $names.Connection }}      = {{ $node.Package }}.{{ $names.Connection }}
	{{ $names.Order }}           = {{ $node.Package }}.{{ $names.Order }}
	{{ $names.OrderField }}      = {{ $node.Package }}.{{ $names.OrderField }}
	{{ $name }}PaginateOption    = {{ $node.Package }}.{{ $name }}PaginateOption
)

// Value forwarders — function/var bodies live in {{ $node.Package }}/gql_pagination.go.
var (
	{{ $name }}QueryPaginate = {{ $node.Package }}.{{ $node.QueryName }}Paginate
	With{{ $names.Order }}   = {{ $node.Package }}.With{{ $names.Order }}
	With{{ $name }}Filter    = {{ $node.Package }}.With{{ $name }}Filter
	{{ $name }}ToEdge        = {{ $node.Package }}.{{ $name }}ToEdge
	Default{{ $name }}Order  = {{ $node.Package }}.Default{{ $name }}Order
)

{{ range $f := $orderFields -}}
var {{ $f.VarName }} = {{ $node.Package }}.{{ $f.VarName }}
{{ end -}}

{{ end }}
