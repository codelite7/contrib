{{ define "gql_collection_subpkg" }}

{{- /*gotype: entgo.io/contrib/entgql.collectionEntityData*/ -}}

{{ $.Config.Header }}

package gqlcollections

{{ $node := $.Node }}
{{ $nodePkg := $node.Package }}
{{ $query := $node.QueryName }}
{{ $receiver := $node.QueryReceiver }}
{{ $spec := print "spec" $query }}

{{- $collects := fieldCollections (filterEdges $node.Edges (skipMode "type")) }}
{{- $fields := filterFields $node.Fields (skipMode "type") }}

import (
	"context"
	"fmt"

	"entgo.io/contrib/entgql"
	"entgo.io/contrib/entgql/gqlcollect"
	"entgo.io/ent/dialect/sql"
	"github.com/99designs/gqlgen/graphql"
	"{{ $.Config.Package }}/{{ $nodePkg }}"
	"{{ $.Config.Package }}/edges"
	{{- /* Import edge-type subpackages for cross-entity Client and Query types. */}}
	{{- range $fc := $collects }}
		{{- if ne $fc.Edge.Type.Package $nodePkg }}
		"{{ $.Config.Package }}/{{ $fc.Edge.Type.Package }}"
		{{- end }}
	{{- end }}
	{{- if $.HasWhereInputTemplate }}
		{{- range $fc := $collects }}
			{{- if and (isRelayConn $fc.Edge) (hasWhereInput $fc.Edge) }}
		"{{ $.Config.Package }}/whereinputs"
				{{- /* break after first */}}
			{{- end }}
		{{- end }}
	{{- end }}
)

// {{ $query }}CollectFields tells the query-builder to eagerly load connected nodes by resolver context.
// Free function (rather than method) because *{{ $query }} is a type alias after PR 6's sub-package split,
// and Go forbids defining methods on alias types from foreign packages.
func {{ $query }}CollectFields({{ $receiver }} *{{ $nodePkg }}.{{ $query }}, ctx context.Context, satisfies ...string) (*{{ $nodePkg }}.{{ $query }}, error) {
	fc := graphql.GetFieldContext(ctx)
	if fc == nil {
		return {{ $receiver }}, nil
	}
	if err := collectField{{ $query }}({{ $receiver }}, ctx, false, graphql.GetOperationContext(ctx), fc.Field, nil, satisfies...); err != nil {
		return nil, err
	}
	return {{ $receiver }}, nil
}

// CollectField{{ $query }} is the exported variant of collectField{{ $query }} used by root gen's
// single-noder code path (which needs oneNode=true).
func CollectField{{ $query }}({{ $receiver }} *{{ $nodePkg }}.{{ $query }}, ctx context.Context, oneNode bool, opCtx *graphql.OperationContext, collected graphql.CollectedField, path []string, satisfies ...string) error {
	return collectField{{ $query }}({{ $receiver }}, ctx, oneNode, opCtx, collected, path, satisfies...)
}

// collectField{{ $query }} is the recursive helper for {{ $query }}CollectFields.
func collectField{{ $query }}({{ $receiver }} *{{ $nodePkg }}.{{ $query }}, ctx context.Context, oneNode bool, opCtx *graphql.OperationContext, collected graphql.CollectedField, path []string, satisfies ...string) error {
	return gqlcollect.Collect({{ $spec }}, {{ $receiver }}, ctx, oneNode, opCtx, collected, path, satisfies...)
}

// {{ $spec }} is {{ $query }}'s field-collection descriptor table. It is assigned in init()
// rather than as a var initializer because it names other entities' collectField helpers,
// which name their own tables — a variable-initialization cycle Go rejects. NOTE: unlike the
// switch it replaces, an edge and a field sharing a GraphQL name is no longer a compile
// error; the map-indexed table silently lets the edge shadow the field.
var {{ $spec }} *gqlcollect.Spec

func init() {
	{{ $spec }} = &gqlcollect.Spec{
	{{- if $node.HasOneFieldID }}
	IDColumn: {{ $nodePkg }}.{{ $node.ID.Constant }},
	{{- end }}
	{{- if $collects }}
	Edges: []gqlcollect.Edge{
		{{- range $fc := $collects }}
			{{- $e := $fc.Edge }}
			{{- $epkg := $e.Type.Package }}
			{{- /* An edge only owns an FK column when it is unique (gen.Edge.Field requires
			       OwnFK), so a relay-connection arm never carries one. */}}
			{{- $fk := "" }}{{ with $e.Field }}{{ $fk = print $nodePkg "." .Constant }}{{ end }}
			{{- range $name := $fc.Mapping }}
				{{- if isRelayConn $e }}
		gqlcollect.Custom("{{ $name }}", collect{{ $node.Name }}{{ $e.StructField }}),
				{{- else if $e.Unique }}
		gqlcollect.Unique("{{ $name }}", {{ if $fk }}{{ $fk }}{{ else }}""{{ end }}, {{ $epkg }}.Implementors, collectField{{ $e.Type.QueryName }}, edges.With{{ $node.Name }}{{ $e.StructField }}),
				{{- else }}
		gqlcollect.Named("{{ $name }}", {{ if $fk }}{{ $fk }}{{ else }}""{{ end }}, {{ $epkg }}.Implementors, collectField{{ $e.Type.QueryName }}, edges.WithNamed{{ $node.Name }}{{ $e.StructField }}),
				{{- end }}
			{{- end }}
		{{- end }}
	},
	{{- end }}
	{{- if $fields }}
	Fields: []gqlcollect.Field{
		{{- range $f := $fields }}
			{{- with fieldMapping $f }}
				{{- range $m := . }}
		{GQL: "{{ $m }}", Column: {{ $nodePkg }}.{{ $f.Constant }}},
				{{- end }}
			{{- end }}
		{{- end }}
		{{- if $node.HasOneFieldID }}
			{{- with fieldMapping $node.ID }}
				{{- range $m := . }}
		{{- /* Spec.IDColumn already seeds the ID column; this entry only marks the
		       name as known so it does not trip unknownSeen. */}}
		{GQL: "{{ $m }}"},
				{{- end }}
			{{- end }}
		{{- end }}
		{GQL: "__typename"},
	},
	Select: func(parent any, columns []string) {
		parent.(*{{ $nodePkg }}.{{ $query }}).Select(columns...)
	},
	{{- end }}
	}
	{{- if $.HasPaginationSubpkg }}
	// Register collectField into the entity subpackage so that the subpackage's Paginate
	// function can call it without a direct import cycle (subpkg -> gen -> subpkg).
	// This registration pattern is required by lever B-2 (pagination + node -> per-entity subpackages).
	{{ $nodePkg }}.Register{{ $query }}CollectFieldFn(collectField{{ $query }})
	{{- end }}
}

{{- /* Relay-connection arms stay generated: the body forks on M2M vs FK inside
       AppendLoadTotal, indexes Edges.TotalCount positionally, and threads per-entity
       pager and paginate-args types. $i must remain the index into $collects — it is
       the TotalCount slot. */}}
{{- range $i, $fc := $collects }}
	{{- $e := $fc.Edge }}
	{{- if isRelayConn $e }}
		{{- $epkg := $e.Type.Package }}
		{{- $oneNode := "false" }}{{ if $e.Unique }}{{ $oneNode = "oneNode" }}{{ end }}
		{{- $tnames := nodePaginationNames $e.Type }}
		{{- $tname := $tnames.Node }}
		{{- $edgeArgsFunc := print "new" $tname "PaginateArgs" }}

// collect{{ $node.Name }}{{ $e.StructField }} is the "{{ $e.Name }}" relay-connection arm, reached
// through gqlcollect.Custom: path already ends in the alias and satisfies is un-widened.
func collect{{ $node.Name }}{{ $e.StructField }}(parent any, ctx context.Context, oneNode bool, opCtx *graphql.OperationContext, field graphql.CollectedField, path []string, satisfies []string) error {
	{{ $receiver }} := parent.(*{{ $nodePkg }}.{{ $query }})
	var (
		alias = field.Alias
		query = (&{{ $epkg }}.{{ $e.Type.ClientName }}{Config: {{ $receiver }}.Config}).Query()
	)
	args := {{ $edgeArgsFunc }}(fieldArgs(ctx, {{ if and $.HasWhereInputTemplate (hasWhereInput $e) }}new(whereinputs.{{ $tnames.WhereInput }}){{ else }}nil{{ end }}, path...))
	if err := validateFirstLast(args.first, args.last); err != nil {
		return fmt.Errorf("validate first and last in path %q: %w", path, err)
	}
	{{- $newPager := print $epkg ".New" $tname "Pager" }}
	pager, err := {{ $newPager }}(args.opts, args.last != nil)
	if err != nil {
		return fmt.Errorf("create new pager in path %q: %w", path, err)
	}
	if query, err = pager.ApplyFilter(query); err != nil {
		return err
	}
	ignoredEdges := !hasCollectedField(ctx, append(path, edgesField)...)
	if hasCollectedField(ctx, append(path, totalCountField)...) || hasCollectedField(ctx, append(path, pageInfoField)...) {
		{{- /* Only add loadTotal query when needs */}}
		hasPagination := args.after != nil || args.first != nil || args.before != nil || args.last != nil
		if hasPagination || ignoredEdges {
			query := query.Clone()
			{{- /* totalCount may be greater than len(nodes). */}}
			{{ $receiver }}.AppendLoadTotal(func(ctx context.Context, nodes []*{{ $nodePkg }}.{{ $node.Name }}) error {
				ids := make([]driver.Value, len(nodes))
				for i := range nodes {
					ids[i] = nodes[i].{{ $node.ID.StructField }}
				}
				{{- if $e.M2M }}
					{{- $fk1idx := 1 }}{{- $fk2idx := 0 }}{{ if $e.IsInverse }}{{ $fk1idx = 0 }}{{ $fk2idx = 1 }}{{ end }}
					{{- $edgeid := print $epkg "." $e.Type.ID.Constant }}
					{{- $nodeid := print $nodePkg "." $e.PKConstant "[" $fk2idx "]" }}
					var v []struct{
						NodeID {{ $node.ID.Type }} `sql:"{{ index $e.Rel.Columns $fk2idx }}"`
						Count int `sql:"count"`
					}
					query.Where(func(s *sql.Selector) {
						joinT := sql.Table({{ $nodePkg }}.{{ $e.TableConstant }})
						s.Join(joinT).On(s.C({{ $edgeid }}), joinT.C({{ $nodePkg }}.{{ $e.PKConstant }}[{{ $fk1idx }}]))
						s.Where(sql.InValues(joinT.C({{ $nodePkg }}.{{ $e.PKConstant }}[{{ $fk2idx }}]), ids...))
						s.Select(joinT.C({{ $nodeid }}), sql.Count("*"))
						s.GroupBy(joinT.C({{ $nodeid }}))
					})
					if err := query.Select().Scan(ctx, &v); err != nil {
						return err
					}
				{{- else }}
					var v []struct{
						NodeID {{ $node.ID.Type }} `sql:"{{ $e.Rel.Column }}"`
						Count int `sql:"count"`
					}
					{{- $fk := print $nodePkg "." $e.ColumnConstant }}
					query.Where(func(s *sql.Selector) {
						s.Where(sql.InValues(s.C({{ $fk }}), ids...))
					})
					if err := query.GroupBy({{ $fk }}).Aggregate(Count()).Scan(ctx, &v); err != nil {
						return err
					}
				{{- end }}
					{{- /* Add support for scanning into maps in dialect/sqlscan. */}}
					m := make(map[{{ $node.ID.Type }}]int, len(v))
					for i := range v {
						m[v[i].NodeID] = v[i].Count
					}
					for i := range nodes {
						n := m[nodes[i].{{ $node.ID.StructField }}]
						if nodes[i].Edges.TotalCount[{{ $i }}] == nil {
							nodes[i].Edges.TotalCount[{{ $i }}] = make(map[string]int)
						}
						nodes[i].Edges.TotalCount[{{ $i }}][alias] = n
					}
				return nil
			})
		} else {
			{{- /* All records will be loaded, so just count it */}}
			{{ $receiver }}.AppendLoadTotal(func(_ context.Context, nodes []*{{ $nodePkg }}.{{ $node.Name }}) error {
				for i := range nodes {
					n := len(nodes[i].Edges.{{ $e.StructField }})
					if nodes[i].Edges.TotalCount[{{ $i }}] == nil {
						nodes[i].Edges.TotalCount[{{ $i }}] = make(map[string]int)
					}
					nodes[i].Edges.TotalCount[{{ $i }}][alias] = n
				}
				return nil
			})
		}
	}
	if ignoredEdges || (args.first != nil && *args.first == 0) || (args.last != nil && *args.last == 0) {
		{{- /* Skip querying edges if "edges" "node" was not required. This is the switch
		       arm's "continue": return without attaching. */}}
		return nil
	}
	if query, err = pager.ApplyCursors(query, args.after, args.before); err != nil {
		return err
	}
	path = append(path, edgesField, nodeField)
	if field := collectedField(ctx, path...); field != nil {
		if err := collectField{{ $e.Type.QueryName }}(query, ctx, {{ $oneNode }}, opCtx, *field, path, gqlcollect.MayAddCondition(satisfies, {{ $epkg }}.Implementors)...); err != nil {
			return err
		}
	}
	if limit := paginateLimit(args.first, args.last); limit > 0 {
		{{- /* Limit per row is not required, as there is only node returned by the top query. */}}
		if oneNode {
			pager.ApplyOrder(query.Limit(limit))
		} else {
			{{- $fk := print $nodePkg "." $fc.Edge.ColumnConstant }}
			{{- if $e.M2M }}
				{{- $pkidx := 0 }}{{ if $e.IsInverse }}{{ $pkidx = 1 }}{{ end }}
				{{- $fk = print $nodePkg "." $e.PKConstant "[" $pkidx "]" }}
			{{- end }}
			modify := entgql.LimitPerRow({{ $fk }}, limit, pager.OrderExpr(query))
			query.AppendModifier(modify)
		}
	} else {
		query = pager.ApplyOrder(query)
	}
	{{- if $e.Unique }}
	edges.With{{ $node.Name }}{{ $e.StructField }}({{ $receiver }}, func(sub *{{ $epkg }}.{{ $e.Type.QueryName }}) {
		*sub = *query
	})
	{{- else }}
	edges.WithNamed{{ $node.Name }}{{ $e.StructField }}({{ $receiver }}, alias, func(wq *{{ $epkg }}.{{ $e.Type.QueryName }}) {
		*wq = *query
	})
	{{- end }}
	return nil
}
	{{- end }}
{{- end }}


{{ $names := nodePaginationNames $node -}}
{{- $name := $names.Node -}}
{{- $filter := print "With" $name "Filter" -}}
{{- $paginateArg := print (camel $name) "PaginateArgs" -}}
{{- $newPaginateArg := print "new" $name "PaginateArgs" -}}
{{- $order := $names.Order -}}
{{- $multiOrder := $node.Annotations.EntGQL.MultiOrder -}}
{{- $orderField := $names.OrderField -}}
type {{ $paginateArg }} struct {
	first, last *int
	after, before *Cursor
	opts []{{ $nodePkg }}.{{ print $name "PaginateOption" }}
}

func {{ $newPaginateArg }}(rv map[string]any) *{{ $paginateArg }} {
	args := &{{ $paginateArg }}{}
	if rv == nil {
		return args
	}
	if v := rv[firstField]; v != nil {
		args.first = v.(*int)
	}
	if v := rv[lastField]; v != nil {
		args.last = v.(*int)
	}
	if v := rv[afterField]; v != nil {
		args.after = v.(*Cursor)
	}
	if v := rv[beforeField]; v != nil {
		args.before = v.(*Cursor)
	}
	{{- with orderFields $node }}
		if v, ok := rv[orderByField]; ok {
			switch v := v.(type) {
			{{- if $multiOrder }}
				case []*{{ $nodePkg }}.{{ $order }}:
					args.opts = append(args.opts, {{ $nodePkg }}.{{ print "With" $order }}(v))
				case []any:
					var orders []*{{ $nodePkg }}.{{ $order }}
					for i := range v {
						mv, ok := v[i].(map[string]any)
						if !ok {
							continue
						}
						var (
							err1, err2 error
							order = &{{ $nodePkg }}.{{ $order }}{Field: &{{ $nodePkg }}.{{ $orderField }}{}, Direction: entgql.OrderDirectionAsc}
						)
						if d, ok := mv[directionField]; ok {
							err1 = order.Direction.UnmarshalGQL(d)
						}
						if f, ok := mv[fieldField]; ok {
							err2 = order.Field.UnmarshalGQL(f)
						}
						if err1 == nil && err2 == nil {
							orders = append(orders, order)
						}
					}
					args.opts = append(args.opts, {{ $nodePkg }}.{{ print "With" $order }}(orders))
			{{- else }}
				case map[string]any:
					var (
						err1, err2 error
						order = &{{ $nodePkg }}.{{ $order }}{Field: &{{ $nodePkg }}.{{ $orderField }}{}, Direction: entgql.OrderDirectionAsc}
					)
					if d, ok := v[directionField]; ok {
						err1 = order.Direction.UnmarshalGQL(d)
					}
					if f, ok := v[fieldField]; ok {
						err2 = order.Field.UnmarshalGQL(f)
					}
					if err1 == nil && err2 == nil {
						args.opts = append(args.opts, {{ $nodePkg }}.{{ print "With" $order }}(order))
					}
				case *{{ $nodePkg }}.{{ $order }}:
					if v != nil {
						args.opts = append(args.opts, {{ $nodePkg }}.{{ print "With" $order }}(v))
					}
			{{- end }}
			}
		}
	{{- end }}
	{{- if $.HasWhereInputTemplate }}
		{{- $withWhere := true }}{{ with $node.Annotations.EntGQL }}{{ if isSkipMode .Skip "where_input" }}{{ $withWhere = false }}{{ end }}{{ end }}
		{{- if $withWhere }}
			{{- $where := $names.WhereInput }}
			if v, ok := rv[whereField].(*whereinputs.{{ $where }}); ok {
				args.opts = append(args.opts, {{ $nodePkg }}.{{ $filter }}(v.Filter))
			}
		{{- end }}
	{{- end }}
	return args
}

{{ end }}
