{{ define "gql_mutation_input" }}

{{- /*gotype: entgo.io/ent/entc/gen.Graph*/ -}}

{{ $pkg := base $.Config.Package }}
{{- with extend $ "Package" $pkg }}
        {{ template "header" . }}
{{- end }}

{{ template "import" $ }}

{{ $gqlNodes := filterNodes $.Nodes (skipMode "mutation_create_input" "mutation_update_input") }}
import (
    "entgo.io/contrib/entgql"
    "entgo.io/contrib/entgql/gqlwhere"
    "entgo.io/ent/runtime/entbuilder"
    {{- range $n := $gqlNodes }}
        {{- template "import/types" $n }}
        "{{ $.Config.Package }}/{{ $n.Package }}"
    {{- end }}
)

{{- range $n := mutationInputs $.Nodes }}
    {{- $names := nodePaginationNames $n.Type }}
    {{- $input := $n.Input }}
    {{- $fields := $n.InputFields }}
    {{- $edges := $n.InputEdges }}
    {{- if $n.IsCreate }}
    // {{ $input }} represents a mutation input for creating {{ plural $names.Node | lower }}.
    {{- else }}
    // {{ $input }} represents a mutation input for updating {{ plural $names.Node | lower }}.
    {{- end }}
    type {{ $input }} struct {
        {{- range $f := $fields }}
            {{- if $f.ClearOp }}
                {{ print "Clear" $f.StructField }} bool `gql:"{{ $f.ClearGQLName }}"`
            {{- end }}
            {{ $f.StructField }} {{ if $f.IsPointer }}*{{ end }}{{ $f.Type }} `gql:"{{ $f.GQLName }}"`
            {{- if $f.AppendOp }}
                {{ $f.MutationAppend }} {{ if $f.IsPointer }}*{{ end }}{{ $f.Type }} `gql:"{{ $f.AppendGQLName }}"`
            {{- end }}
        {{- end }}
        {{- range $e := $edges }}
            {{- if and (not $n.IsCreate) $e.Optional }}
                {{ $e.MutationClear }} bool `gql:"{{ edgeClearGQLName $e }}"`
            {{- end }}
            {{- if $e.Unique }}
                {{- $structField := print (pascal $e.Name) "ID" }}
                {{ $structField }} {{ if or (not $n.IsCreate) $e.Optional }}*{{ end }}{{ $e.Type.ID.Type }} `gql:"{{ edgeInputGQLName $e $n.IsCreate }}" gqlscalar:"ID"`
            {{- else }}
                {{- if $n.IsCreate }}
                    {{- $structField := print (singular $e.Name | pascal) "IDs" }}
                    {{ $structField }} []{{ $e.Type.ID.Type }} `gql:"{{ edgeInputGQLName $e $n.IsCreate }}" gqlscalar:"ID"`
                {{- else }}
                    {{ $e.MutationAdd }} []{{ $e.Type.ID.Type }} `gql:"{{ edgeAddGQLName $e }}" gqlscalar:"ID"`
                    {{ $e.MutationRemove }} []{{ $e.Type.ID.Type }} `gql:"{{ edgeRemoveGQLName $e }}" gqlscalar:"ID"`
                {{- end }}
            {{- end }}
        {{- end }}

        {{- with $tmpls := matchTemplate "helper/gql_mutation_input/fields/*"  }}
            {{- range $tmpl := $tmpls }}
                {{- xtemplate $tmpl $n }}
            {{- end }}
        {{- end }}
    }

    // Mutate applies the {{ $input }} on the {{ $n.MutationName }} builder.
    // Calls the generic entbuilder.Mutation API by descriptor field/edge name
    // (snake_case) because {{ $n.MutationName }} is a generic alias
    // entbuilder.Mutation[T, I] with no typed Set<X>/Clear<X> methods. Errors
    // from SetField etc. can only fire on descriptor mismatch (a codegen bug,
    // not a runtime condition), so we discard them rather than threading an
    // error return through every consumer of Mutate.
    func (i {{ $input }}) Mutate(m *{{ $n.MutationName }}) {
        {{- /* The order of the operators is purposefully sorted: Clear, Set and Append */}}
        {{- range $f := $fields }}
            {{- if $f.ClearOp }}
                if i.{{ print "Clear" $f.StructField }} {
                    _ = m.ClearField("{{ $f.Name }}")
                }
            {{- end }}
            {{- if or $f.Type.Nillable $f.IsPointer }}
                if v := i.{{ $f.StructField }}; v != nil {
                    _ = m.SetField("{{ $f.Name }}", {{ if $f.IsPointer }}*{{ end }}v)
                }
            {{- else }}
                _ = m.SetField("{{ $f.Name }}", i.{{ $f.StructField }})
            {{- end }}
            {{- if $f.AppendOp }}
                if i.{{ $f.MutationAppend }} != nil {
                    _ = m.AppendField("{{ $f.Name }}", {{ if $f.IsPointer }}*{{ end }}i.{{ $f.StructField }})
                }
            {{- end }}
        {{- end }}
        {{- range $e := $edges }}
           {{- if and (not $n.IsCreate) $e.Optional }}
                if i.{{ $e.MutationClear }} {
                    _ = m.ClearEdge("{{ $e.Name }}")
                }
            {{- end }}
            {{- if $e.Unique }}
                {{- $structField := print (pascal $e.Name) "ID" }}
                {{- if or (not $n.IsCreate) $e.Optional }}
                    if v := i.{{ $structField }}; v != nil {
                        _ = m.SetEdgeID("{{ $e.Name }}", *v)
                    }
                {{- else }}
                    _ = m.SetEdgeID("{{ $e.Name }}", i.{{ $structField }})
                {{- end }}
            {{- else }}
                {{- if $n.IsCreate }}
                    {{- $structField := print (singular $e.Name | pascal) "IDs" }}
                    if v := i.{{ $structField }}; len(v) > 0 {
                        _ = m.AddEdgeIDs("{{ $e.Name }}", entbuilder.ToAny(v)...)
                    }
                {{- else }}
                    if v := i.{{ $e.MutationAdd }}; len(v) > 0 {
                        _ = m.AddEdgeIDs("{{ $e.Name }}", entbuilder.ToAny(v)...)
                    }
                    if v := i.{{ $e.MutationRemove }}; len(v) > 0 {
                        _ = m.RemoveEdgeIDs("{{ $e.Name }}", entbuilder.ToAny(v)...)
                    }
                {{- end }}
            {{- end }}
        {{- end }}

        {{- with $tmpls := matchTemplate "helper/gql_mutation_input/mutate/*"  }}
            {{- range $tmpl := $tmpls }}
                {{- xtemplate $tmpl $n }}
            {{- end }}
        {{- end }}
    }

    // UnmarshalGQLContext decodes a GraphQL input object into the mutation input,
    // replacing gqlgen's per-type generated unmarshaler (see gqlwhere.Decode).
    func (i *{{ $input }}) UnmarshalGQLContext(ctx context.Context, v any) error {
        return gqlwhere.Decode(ctx, "{{ $input }}", i, v)
    }

    {{- range $b := $n.Builders }}
    // Set{{ $b }}Input applies the change-set in the {{ $input }} on the {{ $b }} builder.
    func Set{{ $b }}Input(c *{{ $n.Package }}.{{ $b }}, i {{ $input }}) *{{ $n.Package }}.{{ $b }} {
        i.Mutate(c.Mutation())
        return c
    }

    // SetInput applies the change-set in the {{ $input }} on the {{ $b }} builder.
    func (c *{{ $b }}) SetInput(i {{ $input }}) *{{ $b }} {
        return Set{{ $b }}Input(c, i)
    }
    {{- end}}
{{- end }}
{{ end }}
