{{ define "gql_mutation_input_sibling" }}

{{- /*gotype: entgo.io/contrib/entgql.mutationInputEntityData*/ -}}

{{ $.Config.Header }}

package mutationinputs

{{ $inputs := $.Inputs }}
{{ $entityName := $.EntityName }}

{{- /* Collect all nodes needed for imports */}}
{{- $entityNode := index $inputs 0 }}
{{- $pkg := $entityNode.Type.Package }}

import (
    "entgo.io/contrib/entgql/gqlinput"
    "{{ $.Config.Package }}/{{ $pkg }}"
)

{{- range $n := $inputs }}
    {{- $names := nodePaginationNames $n.Type }}
    {{- $input := $n.Input }}
    {{- $fields := $n.InputFields }}
    {{- $edges := $n.InputEdges }}
    {{- if $n.IsCreate }}
    // {{ $input }} represents a mutation input for creating {{ plural $names.Node | lower }}.
    {{- else }}
    // {{ $input }} represents a mutation input for updating {{ plural $names.Node | lower }}.
    {{- end }}
    type {{ $input }} struct {
        {{- range $f := $fields }}
            {{- if $f.ClearOp }}
                {{ print "Clear" $f.StructField }} bool `mutate:"fc:{{ $f.Name }}"`
            {{- end }}
            {{ $f.StructField }} {{ if $f.IsPointer }}*{{ end }}{{ $f.Type }} `mutate:"f:{{ $f.Name }}"`
            {{- if $f.AppendOp }}
                {{ $f.MutationAppend }} {{ if $f.IsPointer }}*{{ end }}{{ $f.Type }} `mutate:"fa:{{ $f.Name }}"`
            {{- end }}
        {{- end }}
        {{- range $e := $edges }}
            {{- if and (not $n.IsCreate) $e.Optional }}
                {{ $e.MutationClear }} bool `mutate:"ec:{{ $e.Name }}"`
            {{- end }}
            {{- if $e.Unique }}
                {{- $structField := print (pascal $e.Name) "ID" }}
                {{ $structField }} {{ if or (not $n.IsCreate) $e.Optional }}*{{ end }}{{ $e.Type.ID.Type }} `mutate:"e:{{ $e.Name }}"`
            {{- else }}
                {{- if $n.IsCreate }}
                    {{- $structField := print (singular $e.Name | pascal) "IDs" }}
                    {{ $structField }} []{{ $e.Type.ID.Type }} `mutate:"ea:{{ $e.Name }}"`
                {{- else }}
                    {{ $e.MutationAdd }} []{{ $e.Type.ID.Type }} `mutate:"ea:{{ $e.Name }}"`
                    {{ $e.MutationRemove }} []{{ $e.Type.ID.Type }} `mutate:"er:{{ $e.Name }}"`
                {{- end }}
            {{- end }}
        {{- end }}

    }

    // Mutate applies the {{ $input }} on the {{ $n.MutationName }} builder.
    // Field/edge routing is driven by the `mutate` struct tags above; see
    // entgo.io/contrib/entgql/gqlinput.
    func (i {{ $input }}) Mutate(m *{{ $pkg }}.{{ $n.MutationName }}) {
        gqlinput.Mutate(i, m)
    }

    {{- range $b := $n.Builders }}
    // Set{{ $b }}Input applies the change-set in the {{ $input }} on the {{ $b }} builder.
    func Set{{ $b }}Input(c *{{ $pkg }}.{{ $b }}, i {{ $input }}) *{{ $pkg }}.{{ $b }} {
        i.Mutate(c.Mutation())
        return c
    }

    {{- end}}
{{- end }}
{{ end }}
