import (
	"{{ $.Config.Package }}/gqlcollections"
)

{{- /* Var forwarders so consumer code referencing gen.<Entity>QueryCollectFields keeps resolving.
   The actual body lives in gen/gqlcollections/<entity>.go (lever B-3d).
   The unexported lowercase forwarder keeps hand-crafted consumer code (e.g. search_pagination.go)
   building when it references the old root-pkg unexported name. */}}
var (
	{{ $query }}CollectFields = gqlcollections.{{ $query }}CollectFields
	collectField{{ $query }} = gqlcollections.CollectField{{ $query }}
)

{{ end }}
