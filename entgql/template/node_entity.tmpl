{{ define "gql_node_entity" }}

{{- /*gotype: entgo.io/contrib/entgql.nodeEntityData*/ -}}

{{ $pkg := base $.Config.Package }}
{{ $.Config.Header }}

package {{ $pkg }}

{{ $gqlNodes := filterNodes $.Nodes (skipMode "type") }}
{{ $idType := gqlIDType $gqlNodes $.IDType }}

{{ $node := $.Node }}
{{ $names := nodePaginationNames $node }}

import (
	"context"

	"{{ $.Config.Package }}/{{ $node.Package }}"
	{{- with $package := $idType.PkgPath }}
		"{{ $package }}"
	{{- end }}
)

// {{ nodeImplementorsVar $node }} forwards to {{ $node.Package }}.Implementors.
// The slice body lives in the entity sub-package so that sibling sub-packages
// (e.g. gqlcollections) can reference it without importing root gen.
var {{ nodeImplementorsVar $node }} = {{ $node.Package }}.Implementors
{{/* Is<Interface>() methods are generated by model/additional/graphql-node in entity files. */}}

{{- if and $idType.Mixed (gqlMarshaler $node.ID) }}
	{{ $receiver := $node.Receiver }}
	func ({{ $receiver }} {{ $node.Name }}) marshalID() string {
		var buf bytes.Buffer
		{{ $receiver }}.ID.MarshalGQL(&buf)
		return buf.String()
	}
{{- end }}

func init() {
	registerNodeResolver({{ $node.Package }}.Table, nodeResolver{
		byID:  {{ camel $node.Name }}Noder,
		byIDs: {{ camel $node.Name }}Noders,
	})
}

func {{ camel $node.Name }}Noder(ctx context.Context, c *Client, id {{ $idType }}) (Noder, error) {
	{{- $unmarshalID := gqlUnmarshaler $node.ID }}
	{{- if $unmarshalID }}
		var uid {{ $node.ID.Type }}
		if err := uid.UnmarshalGQL(id); err != nil {
			return nil, err
		}
	{{- end }}
	return noderOf(ctx, c.{{ $node.Name }}.Query(),
		func(q *{{ $node.QueryName }}) *{{ $node.QueryName }} {
			return q.Where({{ $node.Package }}.F.ID.EQ({{ if $unmarshalID }}u{{ end }}id))
		},
		{{ if $.HasCollectionTemplate }}collectField{{ $node.QueryName }}{{ else }}nil{{ end }},
		(*{{ $node.QueryName }}).Only,
		{{ nodeImplementorsVar $node }},
	)
}

func {{ camel $node.Name }}Noders(ctx context.Context, c *Client, ids []{{ $idType }}, idmap map[{{ $idType }}][]*Noder) error {
	{{- $marshalID := and $idType.Mixed (gqlMarshaler $node.ID) }}
	{{- $unmarshalID := and $idType.Mixed (gqlUnmarshaler $node.ID) }}
	{{- if $unmarshalID }}
		uids := make([]{{ $node.ID.Type }}, len(ids))
		for i, id := range ids {
			if err := uids[i].UnmarshalGQL(id); err != nil {
				return err
			}
		}
	{{- end }}
	return nodersOf(ctx, idmap, c.{{ $node.Name }}.Query(),
		func(q *{{ $node.QueryName }}) *{{ $node.QueryName }} {
			return q.Where({{ $node.Package }}.F.ID.In({{ if $unmarshalID }}u{{ end }}ids...))
		},
		{{ if $.HasCollectionTemplate }}{{ $node.QueryName }}CollectFields{{ else }}nil{{ end }},
		(*{{ $node.QueryName }}).All,
		func(n *{{ $node.Name }}) {{ $idType }} { return n.{{ if $marshalID }}marshalID(){{ else }}ID{{ end }} },
		{{ nodeImplementorsVar $node }},
	)
}

{{ end }}
