// collector implements collectiondispatch.EntityCollector for this entity.
// All EntityCollector method parameters are typed as `any` at the registry
// boundary; each method type-asserts back to the concrete local types.
// This is the indirection that breaks cross-entity import cycles.
//
// Task 5 wired up every method that operates on subpkg-local state
// (paginateArgs accessors, CollectFields, AddQueryModifier). The pager-
// shaped methods (NewPager / ApplyFilter / ApplyCursors / ApplyOrder /
// OrderExpr) and AssignEagerLoad still panic — they need access to
// gen-package types (typed *<entity>Pager, per-entity edge-load helpers
// like loadTodoChildren) which the subpkg cannot import without a
// cycle (gen has type aliases pointing back to subpkg).
//
// Resolving this requires moving the pager type and per-edge load
// helpers into the subpkg too — a follow-up architectural task. Until
// then, Relay-paginated collection edges and cross-entity edge eager
// loading fail at runtime with a clear stub message instead of
// silently returning empty.
type collector struct{}

func (collector) NewQuery(config any) any {
	return {{ $client }}(*config.(*Config)).Query()
}

func (collector) NewPaginateArgs(rv any) any {
	// rv is the field-args map produced by fieldArgs() in the gen package
	// (typed map[string]any). Forward to the subpkg-local constructor
	// (Task 5 emits paginateArgs/newPaginateArgs in this package).
	if rv == nil {
		return newPaginateArgs(nil)
	}
	m, ok := rv.(map[string]any)
	if !ok {
		panic(fmt.Sprintf("collectiondispatch: NewPaginateArgs expected map[string]any, got %T", rv))
	}
	return newPaginateArgs(m)
}

func (collector) PaginateArgsFirst(args any) *int {
	return args.(*paginateArgs).first
}

func (collector) PaginateArgsLast(args any) *int {
	return args.(*paginateArgs).last
}

func (collector) PaginateArgsAfter(args any) any {
	if v := args.(*paginateArgs).after; v != nil {
		return v
	}
	return nil
}

func (collector) PaginateArgsBefore(args any) any {
	if v := args.(*paginateArgs).before; v != nil {
		return v
	}
	return nil
}

func (collector) PaginateArgsOpts(args any) any {
	return args.(*paginateArgs).opts
}

func (collector) NewPager(opts any, last bool) (any, error) {
	panic("TODO Task 6: needs gen-package new{{ $node.Name }}Pager shim accepting []any opts")
}

func (collector) CloneQuery(query any) any {
	return query.(*{{ $query }}).Clone()
}

func (collector) ApplyFilter(pager any, query any) (any, error) {
	panic("TODO Task 6: needs gen-package pager.applyFilter shim through the dispatch boundary")
}

func (collector) ApplyCursors(pager any, query any, after, before any) (any, error) {
	panic("TODO Task 6: needs gen-package pager.applyCursors shim through the dispatch boundary")
}

func (collector) ApplyOrder(pager any, query any) any {
	panic("TODO Task 6: needs gen-package pager.applyOrder shim through the dispatch boundary")
}

func (collector) ApplyLimit(query any, n int) any {
	return query.(*{{ $query }}).Limit(n)
}

func (collector) OrderExpr(pager any, query any) any {
	panic("TODO Task 6: needs gen-package pager.orderExpr shim through the dispatch boundary")
}

func (collector) AddQueryModifier(query any, modifier any) {
	// Mutate the subpkg-local unexported `modifiers` slice directly.
	// The dispatch collector lives in the same package as {{ $query }},
	// so the unexported field is reachable without an exported wrapper.
	mod, ok := modifier.(func(*sql.Selector))
	if !ok {
		panic(fmt.Sprintf("collectiondispatch: AddQueryModifier expected func(*sql.Selector), got %T", modifier))
	}
	q := query.(*{{ $query }})
	q.modifiers = append(q.modifiers, mod)
}

func (collector) CollectFields(ctx context.Context, q any, oneNode bool, opCtx *graphql.OperationContext, collected graphql.CollectedField, path []string, satisfies ...string) error {
	return q.(*{{ $query }}).collectField(ctx, oneNode, opCtx, collected, path, satisfies...)
}

func (collector) IDColumnName() string {
	return {{ printf "%q" $node.ID.StorageKey }}
}

func (collector) AssignEagerLoad(parentQuery any, edgeName, alias string, otherQuery any) {
	// Cross-entity eager-load wiring goes through the parent subpkg's
	// StoreEager seam, but the closure body must execute per-edge SQL
	// using load helpers that today live in the gen-package facade
	// (e.g. loadTodoChildren, loadTodoCategory). The subpkg cannot
	// import the gen package without re-introducing the cross-entity
	// cycle this dispatch design exists to break.
	//
	// Implementing this method requires moving the per-edge load
	// helpers into the subpkg (or a shared internal package the subpkg
	// owns). That's a separate architectural task — until then this
	// stub keeps callers honest: any attempt to walk a collection edge
	// through the new subpkg dispatch path fails fast instead of
	// silently dropping the eager-load configuration.
	_, _, _, _ = parentQuery, edgeName, alias, otherQuery
	panic("TODO: AssignEagerLoad needs per-edge load helpers in subpkg (currently in gen-package facade); subpkg → gen import would cycle. See collection_dispatch.tmpl for full scope.")
}

func init() {
	collectiondispatch.Register({{ printf "%q" $node.Package }}, collector{})
}

