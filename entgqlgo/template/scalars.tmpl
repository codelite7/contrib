// Cursor scalar for graphql-go.
// Cursors are used for pagination in Relay-style connections.
var CursorScalar = graphql.NewScalar(graphql.ScalarConfig{
	Name:        "Cursor",
	Description: "A cursor for pagination. Encodes the position in a result set.",
	Serialize: func(value interface{}) interface{} {
		switch c := value.(type) {
		case *entgqlgo.Cursor[int]:
			if c == nil {
				return nil
			}
			return c.String()
		case entgqlgo.Cursor[int]:
			return c.String()
		case *entgqlgo.Cursor[string]:
			if c == nil {
				return nil
			}
			return c.String()
		case entgqlgo.Cursor[string]:
			return c.String()
		case string:
			return c
		default:
			return nil
		}
	},
	ParseValue: func(value interface{}) interface{} {
		if str, ok := value.(string); ok {
			c := &entgqlgo.Cursor[int]{}
			if err := c.UnmarshalText([]byte(str)); err == nil {
				return c
			}
		}
		return nil
	},
	ParseLiteral: func(valueAST ast.Value) interface{} {
		if str, ok := valueAST.(*ast.StringValue); ok {
			c := &entgqlgo.Cursor[int]{}
			if err := c.UnmarshalText([]byte(str.Value)); err == nil {
				return c
			}
		}
		return nil
	},
})

// TimeScalar is a custom scalar for graphql-go.
// Represents a point in time as an RFC 3339 timestamp.
var TimeScalar = graphql.NewScalar(graphql.ScalarConfig{
	Name:        "Time",
	Description: "A date-time string in RFC 3339 format.",
	Serialize: func(value interface{}) interface{} {
		switch v := value.(type) {
		case time.Time:
			return v.Format(time.RFC3339)
		case *time.Time:
			if v == nil {
				return nil
			}
			return v.Format(time.RFC3339)
		case string:
			return v
		default:
			return nil
		}
	},
	ParseValue: func(value interface{}) interface{} {
		if str, ok := value.(string); ok {
			t, err := time.Parse(time.RFC3339, str)
			if err != nil {
				return nil
			}
			return t
		}
		return nil
	},
	ParseLiteral: func(valueAST ast.Value) interface{} {
		if str, ok := valueAST.(*ast.StringValue); ok {
			t, err := time.Parse(time.RFC3339, str.Value)
			if err != nil {
				return nil
			}
			return t
		}
		return nil
	},
})

// Map scalar for graphql-go.
// Represents arbitrary JSON objects.
var MapScalar = graphql.NewScalar(graphql.ScalarConfig{
	Name:        "Map",
	Description: "An arbitrary JSON object.",
	Serialize: func(value interface{}) interface{} {
		return value
	},
	ParseValue: func(value interface{}) interface{} {
		return value
	},
	ParseLiteral: func(valueAST ast.Value) interface{} {
		if obj, ok := valueAST.(*ast.ObjectValue); ok {
			return parseObjectValue(obj)
		}
		return nil
	},
})

// OrderDirection enum for graphql-go.
var OrderDirectionEnum = graphql.NewEnum(graphql.EnumConfig{
	Name:        "OrderDirection",
	Description: "Possible directions in which to order a list of items.",
	Values: graphql.EnumValueConfigMap{
		"ASC": &graphql.EnumValueConfig{
			Value:       entgqlgo.OrderDirectionAsc,
			Description: "Ascending order.",
		},
		"DESC": &graphql.EnumValueConfig{
			Value:       entgqlgo.OrderDirectionDesc,
			Description: "Descending order.",
		},
	},
})

// NullsDirection enum for graphql-go.
var NullsDirectionEnum = graphql.NewEnum(graphql.EnumConfig{
	Name:        "NullsDirection",
	Description: "Possible directions in which to order null values.",
	Values: graphql.EnumValueConfigMap{
		"FIRST": &graphql.EnumValueConfig{
			Value:       entgqlgo.NullsFirst,
			Description: "Null values are ordered first.",
		},
		"LAST": &graphql.EnumValueConfig{
			Value:       entgqlgo.NullsLast,
			Description: "Null values are ordered last.",
		},
	},
})

// PageInfo type for Relay pagination.
var PageInfoType = graphql.NewObject(graphql.ObjectConfig{
	Name:        "PageInfo",
	Description: "Information about pagination in a connection.",
	Fields: graphql.Fields{
		"hasNextPage": &graphql.Field{
			Type:        graphql.NewNonNull(graphql.Boolean),
			Description: "When paginating forwards, are there more items?",
		},
		"hasPreviousPage": &graphql.Field{
			Type:        graphql.NewNonNull(graphql.Boolean),
			Description: "When paginating backwards, are there more items?",
		},
		"startCursor": &graphql.Field{
			Type:        CursorScalar,
			Description: "When paginating backwards, the cursor to continue.",
		},
		"endCursor": &graphql.Field{
			Type:        CursorScalar,
			Description: "When paginating forwards, the cursor to continue.",
		},
	},
})

// parseObjectValue converts an AST ObjectValue to a map.
func parseObjectValue(obj *ast.ObjectValue) map[string]interface{} {
	result := make(map[string]interface{})
	for _, field := range obj.Fields {
		result[field.Name.Value] = parseASTValue(field.Value)
	}
	return result
}

// parseASTValue converts an AST Value to a Go value.
func parseASTValue(value ast.Value) interface{} {
	switch v := value.(type) {
	case *ast.IntValue:
		return v.Value
	case *ast.FloatValue:
		return v.Value
	case *ast.StringValue:
		return v.Value
	case *ast.BooleanValue:
		return v.Value
	case *ast.EnumValue:
		return v.Value
	case *ast.ListValue:
		var list []interface{}
		for _, item := range v.Values {
			list = append(list, parseASTValue(item))
		}
		return list
	case *ast.ObjectValue:
		return parseObjectValue(v)
	default:
		return nil
	}
}

