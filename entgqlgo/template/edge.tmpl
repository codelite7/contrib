{{ define "gqlgo/edge" }}

{{- /*gotype: entgo.io/ent/entc/gen.Graph*/ -}}

{{- with extend $ "Package" "gqlgo" }}
        {{ template "header" . }}
{{- end }}

{{ $gqlNodes := gqlgoFilterNodes $.Nodes (gqlgoSkipMode "type") }}
{{ $entPkg := base $.Config.Package }}
{{ $split := gqlgoSplitRuntime $ }}

import (
	"context"

	"{{ $.Config.Package }}"
	"github.com/graphql-go/graphql"
)

// Edge resolution helpers for graphql-go.
// These provide optimized edge resolution that checks for eager-loaded data first.

{{- range $n := $gqlNodes }}
{{- range $e := gqlgoFilterEdges $n.Edges (gqlgoSkipMode "type") }}

// {{ $n.Name }}{{ $e.StructField }}Resolver resolves the {{ $e.Name }} edge for {{ $n.Name }}.
// It first checks if the edge was already loaded via eager loading.
// If not, it falls back to querying the database.
type {{ $n.Name }}{{ $e.StructField }}Resolver struct {
	client *{{ $entPkg }}.Client
}

// New{{ $n.Name }}{{ $e.StructField }}Resolver creates a new resolver for the {{ $e.Name }} edge.
func New{{ $n.Name }}{{ $e.StructField }}Resolver(client *{{ $entPkg }}.Client) *{{ $n.Name }}{{ $e.StructField }}Resolver {
	return &{{ $n.Name }}{{ $e.StructField }}Resolver{client: client}
}

// Resolve implements the edge resolution for {{ $n.Name }}.{{ $e.Name }}.
func (r *{{ $n.Name }}{{ $e.StructField }}Resolver) Resolve(p graphql.ResolveParams) (interface{}, error) {
	source, ok := p.Source.(*{{ $entPkg }}.{{ $n.Name }})
	if !ok {
		return nil, nil
	}

	// Check if edge was already loaded via eager loading
	{{- if $e.Unique }}
	if edge := source.Edges.{{ $e.StructField }}; edge != nil {
		return edge, nil
	}

	// Fall back to query
	{{- if $e.Optional }}
	return {{ gqlgoEdgeQueryExpr $split $n $e $entPkg "source" (printf "r.client.%s" $n.Name) }}.Only(p.Context)
	{{- else }}
	edge, err := {{ gqlgoEdgeQueryExpr $split $n $e $entPkg "source" (printf "r.client.%s" $n.Name) }}.Only(p.Context)
	if err != nil {
		return nil, err
	}
	return edge, nil
	{{- end }}
	{{- else }}
	if edges := source.Edges.{{ $e.StructField }}; edges != nil {
		return edges, nil
	}

	// Fall back to query
	return {{ gqlgoEdgeQueryExpr $split $n $e $entPkg "source" (printf "r.client.%s" $n.Name) }}.All(p.Context)
	{{- end }}
}
{{- end }}
{{- end }}

// EdgeResolverMap provides a map of edge resolvers for all types.
type EdgeResolverMap struct {
	client *{{ $entPkg }}.Client
}

// NewEdgeResolverMap creates a new EdgeResolverMap.
func NewEdgeResolverMap(client *{{ $entPkg }}.Client) *EdgeResolverMap {
	return &EdgeResolverMap{client: client}
}

{{- range $n := $gqlNodes }}
{{- range $e := gqlgoFilterEdges $n.Edges (gqlgoSkipMode "type") }}

// {{ $n.Name }}{{ $e.StructField }} returns the resolver for {{ $n.Name }}.{{ $e.Name }}.
func (m *EdgeResolverMap) {{ $n.Name }}{{ $e.StructField }}() graphql.FieldResolveFn {
	return New{{ $n.Name }}{{ $e.StructField }}Resolver(m.client).Resolve
}
{{- end }}
{{- end }}

{{ end }}
