{{ define "gqlgo/node" }}

{{- /*gotype: entgo.io/ent/entc/gen.Graph*/ -}}

{{- with extend $ "Package" "gqlgo" }}
        {{ template "header" . }}
{{- end }}

{{ $gqlNodes := gqlgoFilterNodes $.Nodes (gqlgoSkipMode "type") }}
{{ $idType := gqlgoIDType $gqlNodes $.IDType }}
{{ $entPkg := base $.Config.Package }}

import (
	"context"
	"fmt"

	"{{ $.Config.Package }}"
	"entgo.io/contrib/entgqlgo"
	"github.com/graphql-go/graphql"
)

// Relay Node interface implementation for graphql-go.
// This enables global object identification per the Relay specification.

// Noder wraps the basic Node method for Relay global identification.
type Noder interface {
	// IsNode is a marker method for types that implement Node.
	IsNode()
}

// isNoder is a wrapper that implements Noder for ent types.
type isNoder struct{}

func (isNoder) IsNode() {}

// NodeInterface is the Relay Node interface for global object identification.
var NodeInterface = graphql.NewInterface(graphql.InterfaceConfig{
	Name:        "Node",
	Description: "An object with a globally unique ID.",
	Fields: graphql.Fields{
		"id": &graphql.Field{
			Type:        graphql.NewNonNull(graphql.ID),
			Description: "The globally unique identifier.",
		},
	},
	ResolveType: func(p graphql.ResolveTypeParams) *graphql.Object {
		switch p.Value.(type) {
		{{- range $n := $gqlNodes }}
		case *{{ $entPkg }}.{{ $n.Name }}:
			return {{ $n.Name }}Type
		{{- end }}
		default:
			return nil
		}
	},
})

// NodeResolver implements the node(id: ID!) query for Relay.
type NodeResolver struct {
	client *{{ $entPkg }}.Client
}

// NewNodeResolver creates a new NodeResolver.
func NewNodeResolver(client *{{ $entPkg }}.Client) *NodeResolver {
	return &NodeResolver{client: client}
}

// Resolve resolves a node by its global ID.
func (r *NodeResolver) Resolve(p graphql.ResolveParams) (interface{}, error) {
	id, ok := p.Args["id"]
	if !ok {
		return nil, fmt.Errorf("id argument is required")
	}
	client := clientFromContext(p.Context, r.client)
	return Noder_(client, p.Context, id)
}

// NodesResolver implements the nodes(ids: [ID!]!) query for Relay.
type NodesResolver struct {
	client *{{ $entPkg }}.Client
}

// NewNodesResolver creates a new NodesResolver.
func NewNodesResolver(client *{{ $entPkg }}.Client) *NodesResolver {
	return &NodesResolver{client: client}
}

// Resolve resolves multiple nodes by their global IDs.
func (r *NodesResolver) Resolve(p graphql.ResolveParams) (interface{}, error) {
	ids, ok := p.Args["ids"].([]interface{})
	if !ok {
		return nil, fmt.Errorf("ids argument is required")
	}
	client := clientFromContext(p.Context, r.client)
	return Noders(client, p.Context, ids)
}

// Noder_ returns a node by its global ID.
// The ID is decoded and the appropriate entity is fetched.
func Noder_(client *{{ $entPkg }}.Client, ctx context.Context, id interface{}) (interface{}, error) {
	idStr := fmt.Sprint(id)

	// Try to parse as a global ID (TypeName:LocalID format)
	typeName, localID, err := entgqlgo.ParseGlobalID(idStr)
	if err == nil {
		// Successfully parsed as global ID, route to the right type
		switch typeName {
		{{- range $n := $gqlNodes }}
		case "{{ $n.Name }}":
			{{- if $n.ID.IsInt }}
			idInt, err := parseInt(localID)
			if err != nil {
				return nil, fmt.Errorf("invalid {{ $n.Name }} ID: %w", err)
			}
			return client.{{ $n.Name }}.Get(ctx, idInt)
			{{- else }}
			return client.{{ $n.Name }}.Get(ctx, localID)
			{{- end }}
		{{- end }}
		default:
			return nil, fmt.Errorf("unknown type: %s", typeName)
		}
	}

	// Fallback: try as raw ID (for backward compatibility)
	// Try each type until we find a match
	{{- range $i, $n := $gqlNodes }}
	{{- if $n.ID.IsInt }}
	if idInt, err := parseInt(idStr); err == nil {
		if node, err := client.{{ $n.Name }}.Get(ctx, idInt); err == nil {
			return node, nil
		}
	}
	{{- else }}
	if node, err := client.{{ $n.Name }}.Get(ctx, idStr); err == nil {
		return node, nil
	}
	{{- end }}
	{{- end }}
	return nil, fmt.Errorf("node not found: %v", id)
}

// Noders returns nodes by their global IDs.
// Returns nil for IDs that don't exist (preserving index positions).
func Noders(client *{{ $entPkg }}.Client, ctx context.Context, ids []interface{}) ([]interface{}, error) {
	nodes := make([]interface{}, len(ids))
	for i, id := range ids {
		node, err := Noder_(client, ctx, id)
		if err != nil {
			// Return nil for nodes that don't exist (per Relay spec)
			nodes[i] = nil
			continue
		}
		nodes[i] = node
	}
	return nodes, nil
}

// parseInt converts various types to int for ID lookup.
func parseInt(id interface{}) (int, error) {
	switch v := id.(type) {
	case int:
		return v, nil
	case int64:
		return int(v), nil
	case float64:
		return int(v), nil
	case string:
		var i int
		if _, err := fmt.Sscanf(v, "%d", &i); err != nil {
			return 0, err
		}
		return i, nil
	default:
		return 0, fmt.Errorf("cannot convert %T to int", id)
	}
}

// NodeField returns the GraphQL field definition for the node query.
func NodeField(client *{{ $entPkg }}.Client) *graphql.Field {
	return &graphql.Field{
		Type:        NodeInterface,
		Description: "Fetches an object given its globally unique ID.",
		Args: graphql.FieldConfigArgument{
			"id": &graphql.ArgumentConfig{
				Type:        graphql.NewNonNull(graphql.ID),
				Description: "The globally unique ID of the object.",
			},
		},
		Resolve: NewNodeResolver(client).Resolve,
	}
}

// NodesField returns the GraphQL field definition for the nodes query.
func NodesField(client *{{ $entPkg }}.Client) *graphql.Field {
	return &graphql.Field{
		Type:        graphql.NewNonNull(graphql.NewList(NodeInterface)),
		Description: "Fetches objects given their globally unique IDs.",
		Args: graphql.FieldConfigArgument{
			"ids": &graphql.ArgumentConfig{
				Type:        graphql.NewNonNull(graphql.NewList(graphql.NewNonNull(graphql.ID))),
				Description: "The globally unique IDs of the objects.",
			},
		},
		Resolve: NewNodesResolver(client).Resolve,
	}
}

