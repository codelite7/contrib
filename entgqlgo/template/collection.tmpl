{{ define "gqlgo_collection" }}

{{- /*gotype: entgo.io/ent/entc/gen.Graph*/ -}}

{{ $pkg := base $.Config.Package }}
{{- with extend $ "Package" $pkg }}
        {{ template "header" . }}
{{- end }}

{{ $gqlNodes := filterNodes $.Nodes (skipMode "type") }}

import (
	"context"

	"github.com/graphql-go/graphql"
	"entgo.io/contrib/entgqlgo"
)

// Field collection helpers for graphql-go.
// These allow automatic eager loading of edges based on GraphQL field selection.

{{- range $n := $gqlNodes }}

// {{ $n.QueryName }}CollectFields adds eager loading to a {{ $n.QueryName }} based on the
// selected fields in the GraphQL query. This prevents N+1 query problems.
func {{ $n.QueryName }}CollectFields(ctx context.Context, info graphql.ResolveInfo, query *{{ $n.QueryName }}) *{{ $n.QueryName }} {
	fields := entgqlgo.CollectFields(info)
	return {{ $n.QueryName }}CollectFieldsFromList(ctx, fields, query)
}

// {{ $n.QueryName }}CollectFieldsFromList adds eager loading for a list of field names.
func {{ $n.QueryName }}CollectFieldsFromList(ctx context.Context, fields []string, query *{{ $n.QueryName }}) *{{ $n.QueryName }} {
	{{- $edges := filterEdges $n.Edges (skipMode "type") }}
	{{- if $edges }}
	for _, field := range fields {
		switch field {
		{{- range $e := $edges }}
		case "{{ camel $e.Name }}":
			query = query.With{{ $e.StructField }}()
		{{- end }}
		}
	}
	{{- end }}
	return query
}

// {{ $n.QueryName }}CollectFieldsNested adds eager loading based on nested field selection.
// This is useful for Relay connections where you want to eager load based on
// the selection within edges -> node.
func {{ $n.QueryName }}CollectFieldsNested(ctx context.Context, info graphql.ResolveInfo, query *{{ $n.QueryName }}, path ...string) *{{ $n.QueryName }} {
	fields := entgqlgo.CollectNestedFields(info, path...)
	return {{ $n.QueryName }}CollectFieldsFromList(ctx, fields, query)
}

// {{ $n.QueryName }}CollectFieldsConnection adds eager loading for Relay connection queries.
// It looks at edges -> node -> <fields> to determine what to eager load.
func {{ $n.QueryName }}CollectFieldsConnection(ctx context.Context, info graphql.ResolveInfo, query *{{ $n.QueryName }}) *{{ $n.QueryName }} {
	// Check direct fields
	query = {{ $n.QueryName }}CollectFields(ctx, info, query)

	// Check nested fields in Relay connection pattern: edges -> node -> <fields>
	query = {{ $n.QueryName }}CollectFieldsNested(ctx, info, query, "edges", "node")

	return query
}

// {{ $n.QueryName }}CollectFieldsRecursive adds eager loading with support for nested edge selections.
// It uses CollectFieldsWithArgs to recursively configure eager loading based on the full
// GraphQL selection tree.
func {{ $n.QueryName }}CollectFieldsRecursive(ctx context.Context, info graphql.ResolveInfo, query *{{ $n.QueryName }}) *{{ $n.QueryName }} {
	fields := entgqlgo.CollectFieldsWithArgs(info)
	return {{ $n.QueryName }}CollectFieldsFromFieldInfos(ctx, fields, query)
}

// {{ $n.QueryName }}CollectFieldsFromFieldInfos adds eager loading for nested field selections.
func {{ $n.QueryName }}CollectFieldsFromFieldInfos(ctx context.Context, fields []*entgqlgo.FieldInfo, query *{{ $n.QueryName }}) *{{ $n.QueryName }} {
	{{- $edges := filterEdges $n.Edges (skipMode "type") }}
	{{- if $edges }}
	for _, field := range fields {
		switch field.Name {
		{{- range $e := $edges }}
		case "{{ camel $e.Name }}":
			{{- if $e.Unique }}
			query = query.With{{ $e.StructField }}(func(q *{{ $e.Type.QueryName }}) {
				// Recursively collect nested fields
				if len(field.Children) > 0 {
					{{ $e.Type.QueryName }}CollectFieldsFromFieldInfos(ctx, field.Children, q)
				}
			})
			{{- else }}
			query = query.With{{ $e.StructField }}(func(q *{{ $e.Type.QueryName }}) {
				// Recursively collect nested fields
				if len(field.Children) > 0 {
					{{ $e.Type.QueryName }}CollectFieldsFromFieldInfos(ctx, field.Children, q)
				}
			})
			{{- end }}
		{{- end }}
		}
	}
	{{- end }}
	return query
}
{{- end }}

// FieldCollector provides a generic interface for collecting fields from GraphQL queries.
type FieldCollector struct {
	Info graphql.ResolveInfo
}

// NewFieldCollector creates a new FieldCollector from ResolveInfo.
func NewFieldCollector(info graphql.ResolveInfo) *FieldCollector {
	return &FieldCollector{Info: info}
}

// Fields returns all selected field names at the root level.
func (fc *FieldCollector) Fields() []string {
	return entgqlgo.CollectFields(fc.Info)
}

// HasField checks if a specific field was selected.
func (fc *FieldCollector) HasField(name string) bool {
	return entgqlgo.HasField(fc.Info, name)
}

// NestedFields returns field names at a given path.
func (fc *FieldCollector) NestedFields(path ...string) []string {
	return entgqlgo.CollectNestedFields(fc.Info, path...)
}

// HasNestedField checks if a specific nested field was selected.
func (fc *FieldCollector) HasNestedField(name string, path ...string) bool {
	return entgqlgo.HasNestedField(fc.Info, name, path...)
}

// ConnectionNodeFields returns the fields selected within a Relay connection's nodes.
func (fc *FieldCollector) ConnectionNodeFields() []string {
	return fc.NestedFields("edges", "node")
}

