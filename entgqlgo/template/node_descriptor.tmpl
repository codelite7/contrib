{{/* gotype: entgo.io/ent/entc/gen.Graph */}}

{{ define "gqlgo/node_descriptor" }}

{{- with extend $ "Package" "gqlgo" }}
        {{ template "header" . }}
{{- end }}

{{ $gqlNodes := filterNodes $.Nodes (skipMode "type") }}
{{ $idType := gqlIDType $gqlNodes $.IDType }}
{{ $entPkg := base $.Config.Package }}

import (
	"context"
	"encoding/json"
	"fmt"

	"{{ $.Config.Package }}"
	{{- range $n := $.Nodes }}
		"{{ $.Config.Package }}/{{ $n.Package }}"
	{{- end }}
	{{- with $package := $idType.PkgPath }}
		"{{ $package }}"
	{{- end }}
)

// Node in the graph.
type Node struct {
	ID 	   {{ $idType }} `json:"id,omitempty"`// node id.
	Type   string   `json:"type,omitempty"`   // node type.
	Fields []*Field `json:"fields,omitempty"` // node fields.
	Edges  []*Edge  `json:"edges,omitempty"`  // node edges.
}

// Field of a node.
type Field struct {
	Type  string `json:"type,omitempty"`  // field type.
	Name  string `json:"name,omitempty"`  // field name (as in struct).
	Value string `json:"value,omitempty"` // stringified value.
}

// Edge between two nodes.
type Edge struct {
	Type string `json:"type,omitempty"` // edge type.
	Name string `json:"name,omitempty"` // edge name.
	IDs  []{{ $idType }} `json:"ids,omitempty"`  // node ids (where this edge point to).
}

{{/* Generate helper functions for each type to get node descriptors */}}
{{- range $n := $gqlNodes }}
{{- $fields := filterFields $n.Fields (skipMode "type") }}
{{- $edges := filterEdges $n.Edges (skipMode "type") }}
// {{ $n.Name }}Node returns the Node descriptor for a {{ $n.Name }}.
func {{ $n.Name }}Node(ctx context.Context, n *{{ $entPkg }}.{{ $n.Name }}) (*Node, error) {
	node := &Node{
		ID: n.ID,
		Type: "{{ $n.Name }}",
		Fields: make([]*Field, {{ len $fields }}),
		Edges: make([]*Edge, {{ len $edges }}),
	}
	{{- with $fields }}
	var buf []byte
	var err error
	{{- range $i, $f := $fields }}
	if buf, err = json.Marshal(n.{{ pascal $f.Name }}); err != nil {
		return nil, err
	}
	node.Fields[{{ $i }}] = &Field{
		Type:  "{{ $f.Type }}",
		Name:  "{{ $f.Name }}",
		Value: string(buf),
	}
	{{- end }}
	{{- end }}
	{{- with $edges }}
	{{- range $i, $e := $edges }}
	node.Edges[{{ $i }}] = &Edge{
		Type: "{{ $e.Type.Name }}",
		Name: "{{ $e.Name }}",
	}
	if err := n.{{ print "Query" (pascal $e.Name) }}().
		Select({{ $e.Type.Package }}.FieldID).
		Scan(ctx, &node.Edges[{{ $i }}].IDs); err != nil {
		return nil, err
	}
	{{- end }}
	{{- end }}
	return node, nil
}
{{- end }}

// NodeWithDescriptor returns the node descriptor with given global ID.
//
// This API is helpful in case you want to build
// an administrator tool to browse all types in the system.
func NodeWithDescriptor(client *{{ $entPkg }}.Client, ctx context.Context, id {{ $idType }}) (*Node, error) {
	n, err := Noder_(client, ctx, id)
	if err != nil {
		return nil, err
	}
	switch v := n.(type) {
	{{- range $n := $gqlNodes }}
	case *{{ $entPkg }}.{{ $n.Name }}:
		return {{ $n.Name }}Node(ctx, v)
	{{- end }}
	default:
		return nil, fmt.Errorf("unknown node type: %T", n)
	}
}
{{ end }}
