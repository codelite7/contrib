				Type: {{ if not $f.Optional }}graphql.NewNonNull({{ end }}{{ if $f.IsEnum }}{{ $n.Name }}{{ $f.StructField }}Enum{{ else }}{{ gqlgoType $f }}{{ end }}{{ if not $f.Optional }}){{ end }},
				{{- if $f.Comment }}
