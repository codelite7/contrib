// clientFromContext returns the client from context if available, otherwise falls back to the provided client.
// This enables transactional operations when the context contains a transactional client.
func clientFromContext(ctx context.Context, fallback *{{ $entPkg }}.Client) *{{ $entPkg }}.Client {
	if c := {{ $entPkg }}.FromContext(ctx); c != nil {
		return c
	}
	return fallback
}

// NewSchema creates a new GraphQL schema with Query and Mutation types.
// The client is used for database operations in resolvers.
func NewSchema(client *{{ $entPkg }}.Client) (graphql.Schema, error) {
	return graphql.NewSchema(graphql.SchemaConfig{
		Query:    newQueryType(client),
		Mutation: newMutationType(client),
	})
}

// newQueryType creates the root Query type.
func newQueryType(client *{{ $entPkg }}.Client) *graphql.Object {
	return graphql.NewObject(graphql.ObjectConfig{
		Name: "Query",
		Fields: graphql.Fields{
			{{- range $n := $gqlNodes }}
			{{- $names := gqlgoNodePaginationNames $n }}
			{{- $gqlgoOrderFields := gqlgoOrderFields $n }}
			{{- $multiOrder := $n.Annotations.EntGQL.MultiOrder }}
			{{- $queryFieldName := gqlgoQueryFieldName $n }}
			{{- if $queryFieldName }}
			{{- $queryFieldDesc := gqlgoQueryFieldDescription $n }}
			{{- $isRelayConn := gqlgoIsRelayConnNode $n }}
			{{- if $isRelayConn }}
			"{{ $queryFieldName }}": &graphql.Field{
				Type: graphql.NewNonNull({{ $names.Connection }}Type),
				{{- if $queryFieldDesc }}
				Description: "{{ $queryFieldDesc }}",
				{{- end }}
				Args: graphql.FieldConfigArgument{
					"after": &graphql.ArgumentConfig{
						Type:        CursorScalar,
						Description: "Returns the elements in the list that come after the specified cursor.",
					},
					"first": &graphql.ArgumentConfig{
						Type:        graphql.Int,
						Description: "Returns the first _n_ elements from the list.",
					},
					"before": &graphql.ArgumentConfig{
						Type:        CursorScalar,
						Description: "Returns the elements in the list that come before the specified cursor.",
					},
					"last": &graphql.ArgumentConfig{
						Type:        graphql.Int,
						Description: "Returns the last _n_ elements from the list.",
					},
					{{- if $gqlgoOrderFields }}
					"orderBy": &graphql.ArgumentConfig{
						{{- if $multiOrder }}
						Type:        graphql.NewList(graphql.NewNonNull({{ $names.Order }}InputType)),
						{{- else }}
						Type:        {{ $names.Order }}InputType,
						{{- end }}
						Description: "Ordering options for {{ plural $n.Name }} returned from the connection.",
					},
					{{- end }}
					"where": &graphql.ArgumentConfig{
						Type:        {{ $names.WhereInput }}Type,
						Description: "Filtering options for {{ plural $n.Name }} returned from the connection.",
					},
				},
				Resolve: func(p graphql.ResolveParams) (interface{}, error) {
					args, err := ParsePaginationArgs(p)
					if err != nil {
						return nil, err
					}
					c := clientFromContext(p.Context, client)
					query := c.{{ $n.Name }}.Query()
					// Apply where filter.
					if whereArg, ok := p.Args["where"].(map[string]interface{}); ok {
						whereInput, err := Parse{{ $names.WhereInput }}(whereArg)
						if err != nil {
							return nil, fmt.Errorf("parsing where input: %w", err)
						}
						query, err = whereInput.Filter(query)
						if err != nil {
							return nil, fmt.Errorf("applying where filter: %w", err)
						}
					}
					// Eager-load edges selected under edges { node { ... } }.
					query = {{ $n.QueryName }}CollectFieldsConnection(p.Context, p.Info, query)
					{{- if $gqlgoOrderFields }}
					{{- if $multiOrder }}
					var orders []*{{ $names.Order }}
					if orderByArg, ok := p.Args["orderBy"].([]interface{}); ok {
						orders, err = Parse{{ $names.Order }}List(orderByArg)
						if err != nil {
							return nil, fmt.Errorf("parsing orderBy: %w", err)
						}
					}
					return paginate{{ $n.Name }}Query(p.Context, query, args.After, args.Before, args.First, args.Last, orders)
					{{- else }}
					var order *{{ $names.Order }}
					if orderByArg, ok := p.Args["orderBy"].(map[string]interface{}); ok {
						order, err = Parse{{ $names.Order }}(orderByArg)
						if err != nil {
							return nil, fmt.Errorf("parsing orderBy: %w", err)
						}
					}
					return paginate{{ $n.Name }}Query(p.Context, query, args.After, args.Before, args.First, args.Last, order)
					{{- end }}
					{{- else }}
					return paginate{{ $n.Name }}Query(p.Context, query, args.After, args.Before, args.First, args.Last)
					{{- end }}
				},
			},
			{{- else }}
			"{{ $queryFieldName }}": &graphql.Field{
				Type: graphql.NewNonNull(graphql.NewList(graphql.NewNonNull({{ $n.Name }}Type))),
				{{- if $queryFieldDesc }}
				Description: "{{ $queryFieldDesc }}",
				{{- end }}
				Resolve: func(p graphql.ResolveParams) (interface{}, error) {
					c := clientFromContext(p.Context, client)
					query := c.{{ $n.Name }}.Query()
					query = {{ $n.QueryName }}CollectFields(p.Context, p.Info, query)
					return query.All(p.Context)
				},
			},
			{{- end }}
			{{- end }}
			{{- end }}
			{{- /* Relay Node interface */ -}}
			"node": &graphql.Field{
				Type: NodeInterface,
				Args: graphql.FieldConfigArgument{
					"id": &graphql.ArgumentConfig{
						Type:        graphql.NewNonNull(graphql.ID),
						Description: "The ID of the node.",
					},
				},
				Description: "Fetches an object given its ID.",
				Resolve: func(p graphql.ResolveParams) (interface{}, error) {
					id, ok := p.Args["id"]
					if !ok {
						return nil, nil
					}
					c := clientFromContext(p.Context, client)
					return Noder_(c, p.Context, fmt.Sprint(id))
				},
			},
			"nodes": &graphql.Field{
				Type: graphql.NewNonNull(graphql.NewList(NodeInterface)),
				Args: graphql.FieldConfigArgument{
					"ids": &graphql.ArgumentConfig{
						Type:        graphql.NewNonNull(graphql.NewList(graphql.NewNonNull(graphql.ID))),
						Description: "The IDs of the nodes.",
					},
				},
				Description: "Fetches objects given their IDs.",
				Resolve: func(p graphql.ResolveParams) (interface{}, error) {
					ids, ok := p.Args["ids"].([]interface{})
					if !ok {
						return nil, nil
					}
					c := clientFromContext(p.Context, client)
					return Noders(c, p.Context, ids)
				},
			},
		},
	})
}

// newMutationType creates the root Mutation type.
func newMutationType(client *{{ $entPkg }}.Client) *graphql.Object {
	return graphql.NewObject(graphql.ObjectConfig{
		Name: "Mutation",
		Fields: graphql.Fields{
			{{- range $m := gqlgoMutationInputs $.Nodes }}
			{{- $n := $m.Type }}
			{{- if $m.IsCreate }}
			"create{{ $n.Name }}": &graphql.Field{
				Type: {{ $n.Name }}Type,
				Args: graphql.FieldConfigArgument{
					"input": &graphql.ArgumentConfig{
						Type:        graphql.NewNonNull(Create{{ $n.Name }}InputType),
						Description: "Input for creating a {{ $n.Name }}.",
					},
				},
				Description: "Create a new {{ $n.Name }}.",
				Resolve: func(p graphql.ResolveParams) (interface{}, error) {
					inputArg, ok := p.Args["input"]
					if !ok {
						return nil, fmt.Errorf("input is required")
					}
					inputMap, ok := inputArg.(map[string]interface{})
					if !ok {
						return nil, fmt.Errorf("input must be an object")
					}
					input, err := ParseCreate{{ $n.Name }}Input(inputMap)
					if err != nil {
						return nil, fmt.Errorf("parsing input: %w", err)
					}
					c := clientFromContext(p.Context, client)
					return c.{{ $n.Name }}.Create().SetInput(*input).Save(p.Context)
				},
			},
			{{- else }}
			"update{{ $n.Name }}": &graphql.Field{
				Type: {{ $n.Name }}Type,
				Args: graphql.FieldConfigArgument{
					"id": &graphql.ArgumentConfig{
						Type:        graphql.NewNonNull(graphql.ID),
						Description: "The ID of the {{ $n.Name }} to update.",
					},
					"input": &graphql.ArgumentConfig{
						Type:        graphql.NewNonNull(Update{{ $n.Name }}InputType),
						Description: "Input for updating a {{ $n.Name }}.",
					},
				},
				Description: "Update an existing {{ $n.Name }}.",
				Resolve: func(p graphql.ResolveParams) (interface{}, error) {
					id, ok := p.Args["id"]
					if !ok {
						return nil, fmt.Errorf("id is required")
					}
					inputArg, ok := p.Args["input"]
					if !ok {
						return nil, fmt.Errorf("input is required")
					}
					inputMap, ok := inputArg.(map[string]interface{})
					if !ok {
						return nil, fmt.Errorf("input must be an object")
					}
					input, err := ParseUpdate{{ $n.Name }}Input(inputMap)
					if err != nil {
						return nil, fmt.Errorf("parsing input: %w", err)
					}
					c := clientFromContext(p.Context, client)
					{{- if $n.ID.IsInt }}
					idInt, err := strconv.Atoi(fmt.Sprint(id))
					if err != nil {
						return nil, err
					}
					return c.{{ $n.Name }}.UpdateOneID(idInt).SetInput(*input).Save(p.Context)
					{{- else }}
					idUUID, err := uuid.Parse(fmt.Sprint(id))
					if err != nil {
						return nil, fmt.Errorf("invalid UUID: %w", err)
					}
					return c.{{ $n.Name }}.UpdateOneID(idUUID).SetInput(*input).Save(p.Context)
					{{- end }}
				},
			},
			"delete{{ $n.Name }}": &graphql.Field{
				Type: graphql.Boolean,
				Args: graphql.FieldConfigArgument{
					"id": &graphql.ArgumentConfig{
						Type:        graphql.NewNonNull(graphql.ID),
						Description: "The ID of the {{ $n.Name }} to delete.",
					},
				},
				Description: "Delete a {{ $n.Name }}.",
				Resolve: func(p graphql.ResolveParams) (interface{}, error) {
					id, ok := p.Args["id"]
					if !ok {
						return false, fmt.Errorf("id is required")
					}
					c := clientFromContext(p.Context, client)
					{{- if $n.ID.IsInt }}
					idInt, err := strconv.Atoi(fmt.Sprint(id))
					if err != nil {
						return false, err
					}
					err = c.{{ $n.Name }}.DeleteOneID(idInt).Exec(p.Context)
					{{- else }}
					idUUID, err := uuid.Parse(fmt.Sprint(id))
					if err != nil {
						return false, fmt.Errorf("invalid UUID: %w", err)
					}
					err = c.{{ $n.Name }}.DeleteOneID(idUUID).Exec(p.Context)
					{{- end }}
					return err == nil, err
				},
			},
			{{- end }}
			{{- end }}
		},
	})
}

{{/* Generate mutation input types */}}
var (
{{- range $m := gqlgoMutationInputs $.Nodes }}
	{{- $n := $m.Type }}
	{{- $names := gqlgoNodePaginationNames $n }}
	{{- $inputEdges := $m.InputEdges }}
	{{- if $m.IsCreate }}
	// Create{{ $n.Name }}InputType is the GraphQL input type for creating a {{ $n.Name }}.
	Create{{ $n.Name }}InputType = graphql.NewInputObject(graphql.InputObjectConfig{
		Name: "Create{{ $n.Name }}Input",
		Fields: graphql.InputObjectConfigFieldMap{
			{{- range $f := gqlgoFilterFields $n.Fields (gqlgoSkipMode "mutation_create_input") }}
			{{- if not $f.Sensitive }}
			{{- if not $f.Immutable }}
			"{{ camel $f.Name }}": &graphql.InputObjectFieldConfig{
				Type: {{ if not $f.Optional }}graphql.NewNonNull({{ end }}{{ if $f.IsEnum }}{{ $n.Name }}{{ $f.StructField }}Enum{{ else }}{{ gqlgoType $f }}{{ end }}{{ if not $f.Optional }}){{ end }},
				{{- if $f.Comment }}
				Description: "{{ $f.Comment }}",
				{{- end }}
			},
			{{- end }}
			{{- end }}
			{{- end }}
			{{- /* Edge fields for create - skip if field with same name exists */ -}}
			{{- range $e := $inputEdges }}
			{{- if $e.Unique }}
			{{- if not (gqlgoHasFieldNamed $n (printf "%sID" (camel $e.Name))) }}
			"{{ camel $e.Name }}ID": &graphql.InputObjectFieldConfig{
				Type: graphql.ID,
				Description: "ID of the {{ $e.Name }} edge.",
			},
			{{- end }}
			{{- else }}
			{{- if not (gqlgoHasFieldNamed $n (printf "%sIDs" (singular (camel $e.Name)))) }}
			"{{ singular (camel $e.Name) }}IDs": &graphql.InputObjectFieldConfig{
				Type: graphql.NewList(graphql.NewNonNull(graphql.ID)),
				Description: "IDs of the {{ $e.Name }} edges.",
			},
			{{- end }}
			{{- end }}
			{{- end }}
		},
	})
	{{- else }}
	// Update{{ $n.Name }}InputType is the GraphQL input type for updating a {{ $n.Name }}.
	Update{{ $n.Name }}InputType = graphql.NewInputObject(graphql.InputObjectConfig{
		Name: "Update{{ $n.Name }}Input",
		Fields: graphql.InputObjectConfigFieldMap{
			{{- range $f := gqlgoFilterFields $n.Fields (gqlgoSkipMode "mutation_update_input") }}
			{{- if not $f.Sensitive }}
			{{- if not $f.Immutable }}
			"{{ camel $f.Name }}": &graphql.InputObjectFieldConfig{
				Type: {{ if $f.IsEnum }}{{ $n.Name }}{{ $f.StructField }}Enum{{ else }}{{ gqlgoType $f }}{{ end }},
				{{- if $f.Comment }}
				Description: "{{ $f.Comment }}",
				{{- end }}
			},
			{{- if $f.Optional }}
			"clear{{ $f.StructField }}": &graphql.InputObjectFieldConfig{
				Type: graphql.Boolean,
				Description: "Clear the {{ camel $f.Name }} field.",
			},
			{{- end }}
			{{- end }}
			{{- end }}
			{{- end }}
			{{- /* Edge fields for update - skip if field with same name exists */ -}}
			{{- range $e := $inputEdges }}
			{{- if $e.Unique }}
			{{- if not (gqlgoHasFieldNamed $n (printf "%sID" (camel $e.Name))) }}
			"{{ camel $e.Name }}ID": &graphql.InputObjectFieldConfig{
				Type: graphql.ID,
				Description: "ID of the {{ $e.Name }} edge.",
			},
			{{- end }}
			{{- if $e.Optional }}
			"clear{{ $e.StructField }}": &graphql.InputObjectFieldConfig{
				Type: graphql.Boolean,
				Description: "Clear the {{ camel $e.Name }} edge.",
			},
			{{- end }}
			{{- else }}
			{{- if not (gqlgoHasFieldNamed $n (printf "add%sIDs" (singular $e.Name | pascal))) }}
			"add{{ singular $e.Name | pascal }}IDs": &graphql.InputObjectFieldConfig{
				Type: graphql.NewList(graphql.NewNonNull(graphql.ID)),
				Description: "IDs to add to the {{ $e.Name }} edges.",
			},
			{{- end }}
			{{- if not (gqlgoHasFieldNamed $n (printf "remove%sIDs" (singular $e.Name | pascal))) }}
			"remove{{ singular $e.Name | pascal }}IDs": &graphql.InputObjectFieldConfig{
				Type: graphql.NewList(graphql.NewNonNull(graphql.ID)),
				Description: "IDs to remove from the {{ $e.Name }} edges.",
			},
			{{- end }}
			"clear{{ $e.StructField }}": &graphql.InputObjectFieldConfig{
				Type: graphql.Boolean,
				Description: "Clear all {{ $e.Name }} edges.",
			},
			{{- end }}
			{{- end }}
		},
	})
	{{- end }}
{{- end }}
)

{{- /* Generate mutation input parsing helpers */ -}}
{{- range $m := gqlgoMutationInputs $.Nodes }}
{{- $n := $m.Type }}
{{- $inputEdges := $m.InputEdges }}
{{- if $m.IsCreate }}

// ParseCreate{{ $n.Name }}Input parses a map into Create{{ $n.Name }}Input.
func ParseCreate{{ $n.Name }}Input(input map[string]interface{}) (*{{ $entPkg }}.Create{{ $n.Name }}Input, error) {
	result := &{{ $entPkg }}.Create{{ $n.Name }}Input{}
{{- range $f := gqlgoFilterFields $n.Fields (gqlgoSkipMode "mutation_create_input") }}
{{- if not $f.Sensitive }}
{{- if not $f.Immutable }}
{{- if not $f.IsEdgeField }}
{{- $isPointer := or $f.Optional $f.Default (not (not $f.DefaultFunc)) }}
	if v, ok := input["{{ camel $f.Name }}"]; ok && v != nil {
{{- if $f.IsEnum }}
		if str, ok := v.(string); ok {
{{- if $isPointer }}
			val := {{ $n.Package }}.{{ $f.StructField }}(str)
			result.{{ $f.StructField }} = &val
{{- else }}
			result.{{ $f.StructField }} = {{ $n.Package }}.{{ $f.StructField }}(str)
{{- end }}
		}
{{- else if eq $f.Type.String "int" }}
		switch val := v.(type) {
		case int:
{{- if $isPointer }}
			result.{{ $f.StructField }} = &val
{{- else }}
			result.{{ $f.StructField }} = val
{{- end }}
		case float64:
			i := int(val)
{{- if $isPointer }}
			result.{{ $f.StructField }} = &i
{{- else }}
			result.{{ $f.StructField }} = i
{{- end }}
		}
{{- else if eq $f.Type.String "string" }}
		if str, ok := v.(string); ok {
{{- if $isPointer }}
			result.{{ $f.StructField }} = &str
{{- else }}
			result.{{ $f.StructField }} = str
{{- end }}
		}
{{- else if eq $f.Type.String "bool" }}
		if b, ok := v.(bool); ok {
{{- if $isPointer }}
			result.{{ $f.StructField }} = &b
{{- else }}
			result.{{ $f.StructField }} = b
{{- end }}
		}
{{- else }}
		// Handle {{ $f.Type.String }} type
{{- end }}
	}
{{- end }}
{{- end }}
{{- end }}
{{- end }}
	{{- /* Parse edge IDs */ -}}
	{{- range $e := $inputEdges }}
	{{- if $e.Unique }}
	if v, ok := input["{{ camel $e.Name }}ID"]; ok && v != nil {
		{{- if $e.Type.ID.IsInt }}
		id, err := strconv.Atoi(fmt.Sprint(v))
		if err != nil {
			return nil, fmt.Errorf("invalid {{ camel $e.Name }}ID: %w", err)
		}
		{{- if $e.Optional }}
		result.{{ $e.StructField }}ID = &id
		{{- else }}
		result.{{ $e.StructField }}ID = id
		{{- end }}
		{{- else }}
		id, err := uuid.Parse(fmt.Sprint(v))
		if err != nil {
			return nil, fmt.Errorf("invalid {{ camel $e.Name }}ID: %w", err)
		}
		{{- if $e.Optional }}
		result.{{ $e.StructField }}ID = &id
		{{- else }}
		result.{{ $e.StructField }}ID = id
		{{- end }}
		{{- end }}
	}
	{{- else }}
	if v, ok := input["{{ singular (camel $e.Name) }}IDs"]; ok && v != nil {
		if ids, ok := v.([]interface{}); ok {
			for _, idVal := range ids {
				{{- if $e.Type.ID.IsInt }}
				id, err := strconv.Atoi(fmt.Sprint(idVal))
				if err != nil {
					return nil, fmt.Errorf("invalid {{ singular (camel $e.Name) }}ID: %w", err)
				}
				result.{{ singular $e.Name | pascal }}IDs = append(result.{{ singular $e.Name | pascal }}IDs, id)
				{{- else }}
				id, err := uuid.Parse(fmt.Sprint(idVal))
				if err != nil {
					return nil, fmt.Errorf("invalid {{ singular (camel $e.Name) }}ID: %w", err)
				}
				result.{{ singular $e.Name | pascal }}IDs = append(result.{{ singular $e.Name | pascal }}IDs, id)
				{{- end }}
			}
		}
	}
	{{- end }}
	{{- end }}
	return result, nil
}
{{- else }}

// ParseUpdate{{ $n.Name }}Input parses a map into Update{{ $n.Name }}Input.
func ParseUpdate{{ $n.Name }}Input(input map[string]interface{}) (*{{ $entPkg }}.Update{{ $n.Name }}Input, error) {
	result := &{{ $entPkg }}.Update{{ $n.Name }}Input{}
{{- range $f := gqlgoFilterFields $n.Fields (gqlgoSkipMode "mutation_update_input") }}
{{- if not $f.Sensitive }}
{{- if not $f.Immutable }}
{{- if not $f.IsEdgeField }}
	if v, ok := input["{{ camel $f.Name }}"]; ok && v != nil {
{{- if $f.IsEnum }}
		if str, ok := v.(string); ok {
			val := {{ $n.Package }}.{{ $f.StructField }}(str)
			result.{{ $f.StructField }} = &val
		}
{{- else if eq $f.Type.String "int" }}
		switch val := v.(type) {
		case int:
			i := val
			result.{{ $f.StructField }} = &i
		case float64:
			i := int(val)
			result.{{ $f.StructField }} = &i
		}
{{- else if eq $f.Type.String "string" }}
		if str, ok := v.(string); ok {
			s := str
			result.{{ $f.StructField }} = &s
		}
{{- else if eq $f.Type.String "bool" }}
		if b, ok := v.(bool); ok {
			bb := b
			result.{{ $f.StructField }} = &bb
		}
{{- else }}
		// Handle {{ $f.Type.String }} type
{{- end }}
	}
{{- if $f.Optional }}
	if v, ok := input["clear{{ $f.StructField }}"]; ok {
		if b, ok := v.(bool); ok {
			result.Clear{{ $f.StructField }} = b
		}
	}
{{- end }}
{{- end }}
{{- end }}
{{- end }}
{{- end }}
	{{- /* Parse edge IDs for update */ -}}
	{{- range $e := $inputEdges }}
	{{- if $e.Unique }}
	if v, ok := input["{{ camel $e.Name }}ID"]; ok && v != nil {
		{{- if $e.Type.ID.IsInt }}
		id, err := strconv.Atoi(fmt.Sprint(v))
		if err != nil {
			return nil, fmt.Errorf("invalid {{ camel $e.Name }}ID: %w", err)
		}
		result.{{ $e.StructField }}ID = &id
		{{- else }}
		id, err := uuid.Parse(fmt.Sprint(v))
		if err != nil {
			return nil, fmt.Errorf("invalid {{ camel $e.Name }}ID: %w", err)
		}
		result.{{ $e.StructField }}ID = &id
		{{- end }}
	}
	{{- if $e.Optional }}
	if v, ok := input["clear{{ $e.StructField }}"]; ok {
		if b, ok := v.(bool); ok {
			result.Clear{{ $e.StructField }} = b
		}
	}
	{{- end }}
	{{- else }}
